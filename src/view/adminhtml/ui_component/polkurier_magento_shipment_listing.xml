<!-- Magento's shipment page: every Polkurier order the shipment has had, the cancelled ones
     before it included, and what can be done with each -->
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">polkurier_magento_shipment_listing.polkurier_magento_shipment_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>polkurier_magento_shipment_columns</spinner>
        <deps>
            <dep>polkurier_magento_shipment_listing.polkurier_magento_shipment_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="polkurier_magento_shipment_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">entity_id</param>
            </storageConfig>
            <filterUrlParams>
                <param name="shipment_id">*</param>
            </filterUrlParams>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Polkurier_Shipping::shipments</aclResource>
        <dataProvider class="Polkurier\Shipping\Ui\Component\DataProvider\GridDataProvider" name="polkurier_magento_shipment_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <columns name="polkurier_magento_shipment_columns">
        <column name="polkurier_number" sortOrder="10">
            <settings>
                <label translate="true">Polkurier order</label>
                </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="20">
            <settings>
                <label translate="true">Created</label>
                <dataType>date</dataType>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="state" component="Magento_Ui/js/grid/columns/select" sortOrder="30">
            <settings>
                <label translate="true">State</label>
                <options class="Polkurier\Shipping\Model\Config\Source\ShipmentState"/>
                <dataType>select</dataType>
            </settings>
        </column>
        <column name="carrier_code" component="Magento_Ui/js/grid/columns/select" sortOrder="40">
            <settings>
                <label translate="true">Carrier</label>
                <options class="Polkurier\Shipping\Model\Config\Source\CarrierName"/>
                <dataType>select</dataType>
            </settings>
        </column>
        <column name="waybills" class="Polkurier\Shipping\Ui\Component\Listing\Column\WaybillsColumn" sortOrder="60">
            <settings>
                <label translate="true">Waybills</label>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="status_label" sortOrder="70">
            <settings>
                <label translate="true">Delivery status</label>
                </settings>
        </column>
        <column name="last_error" sortOrder="80">
            <settings>
                <label translate="true">Last error</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <actionsColumn name="actions" class="Polkurier\Shipping\Ui\Component\Listing\Column\ShipmentActionsColumn" sortOrder="90">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="onOrderPage" xsi:type="boolean">true</item>
                </item>
            </argument>
            <settings>
                <indexField>entity_id</indexField>
                <label translate="true">Actions</label>
            </settings>
        </actionsColumn>
    </columns>
</listing>
