<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- The customer's pickup point, in the Shipping & Handling Information; placed there by
             Plugin\Adminhtml\ShippingInfoPlugin, since Magento's template renders no children. -->
        <referenceBlock name="order_shipping_view">
            <block class="Magento\Backend\Block\Template" name="polkurier_order_point" template="Polkurier_Shipping::order/pickup-point.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Polkurier\Shipping\ViewModel\Adminhtml\OrderPickupPoint</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
