<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">polkurier_bank_account_listing.polkurier_bank_account_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="polkurier/bankaccount/edit"/>
                <class>primary</class>
                <label translate="true">Add bank account</label>
            </button>
            <button name="sync" class="Polkurier\Shipping\Ui\Component\Control\SyncBankAccountsButton"/>
        </buttons>
        <spinner>polkurier_bank_account_listing_columns</spinner>
        <deps>
            <dep>polkurier_bank_account_listing.polkurier_bank_account_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="polkurier_bank_account_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">account_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Polkurier_Shipping::bank_accounts</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="polkurier_bank_account_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>account_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <action name="delete">
                <settings>
                    <url path="polkurier/bankaccount/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                    <confirm>
                        <title translate="true">Delete bank accounts</title>
                        <message translate="true">Accounts from Polkurier come back at the next synchronization; delete them in the Polkurier panel.</message>
                    </confirm>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="polkurier_bank_account_listing_columns">
        <settings>
            <editorConfig>
                <param name="clientConfig" xsi:type="array">
                    <item name="saveUrl" xsi:type="url" path="polkurier/bankaccount/inlineEdit"/>
                    <item name="validateBeforeSave" xsi:type="boolean">false</item>
                </param>
                <param name="indexField" xsi:type="string">account_id</param>
                <param name="enabled" xsi:type="boolean">true</param>
                <param name="selectProvider" xsi:type="string">polkurier_bank_account_listing.polkurier_bank_account_listing.polkurier_bank_account_listing_columns.ids</param>
            </editorConfig>
            <childDefaults>
                <param name="fieldAction" xsi:type="array">
                    <item name="provider" xsi:type="string">polkurier_bank_account_listing.polkurier_bank_account_listing.polkurier_bank_account_listing_columns_editor</item>
                    <item name="target" xsi:type="string">startEdit</item>
                    <item name="params" xsi:type="array">
                        <item name="0" xsi:type="string">${ $.$data.rowIndex }</item>
                        <item name="1" xsi:type="boolean">true</item>
                    </item>
                </param>
            </childDefaults>
        </settings>
        <selectionsColumn name="ids">
            <settings>
                <indexField>account_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="account_id">
            <settings>
                <label translate="true">ID</label>
                <filter>textRange</filter>
                <visible>false</visible>
            </settings>
        </column>
        <column name="website_id" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <label translate="true">Website</label>
                <options class="Magento\Config\Model\Config\Source\Website"/>
                <filter>select</filter>
                <dataType>select</dataType>
            </settings>
        </column>
        <column name="name">
            <settings>
                <label translate="true">Account name</label>
                <filter>text</filter>
                <editor>
                    <editorType>text</editorType>
                </editor>
            </settings>
        </column>
        <column name="number">
            <settings>
                <label translate="true">Account number</label>
                <filter>text</filter>
                <editor>
                    <editorType>text</editorType>
                </editor>
            </settings>
        </column>
        <column name="is_default" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <label translate="true">Default</label>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <editor>
                    <editorType>select</editorType>
                </editor>
            </settings>
        </column>
        <column name="sync_state" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <label translate="true">Synchronization</label>
                <options class="Polkurier\Shipping\Model\Config\Source\SyncState"/>
                <filter>select</filter>
                <dataType>select</dataType>
            </settings>
        </column>
        <column name="sync_error">
            <settings>
                <label translate="true">Sync error</label>
                <filter>text</filter>
                <visible>false</visible>
            </settings>
        </column>
        <column name="synced_at" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <label translate="true">Last synchronized</label>
                <filter>dateRange</filter>
                <dataType>date</dataType>
            </settings>
        </column>
        <column name="ext_id">
            <settings>
                <label translate="true">Polkurier ID</label>
                <filter>text</filter>
                <visible>false</visible>
            </settings>
        </column>
        <actionsColumn name="actions" class="Polkurier\Shipping\Ui\Component\Listing\Column\EditActions">
            <settings>
                <indexField>account_id</indexField>
                <label translate="true">Actions</label>
            </settings>
        </actionsColumn>
    </columns>
</listing>
