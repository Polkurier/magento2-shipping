<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">polkurier_shipment_form.polkurier_shipment_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Polkurier shipment</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <namespace>polkurier_shipment_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>polkurier_shipment_form.polkurier_shipment_form_data_source</dep>
        </deps>
        <buttons>
            <button name="back" class="Polkurier\Shipping\Ui\Component\Control\BackToOrderButton"/>
            <button name="save" class="Polkurier\Shipping\Ui\Component\Control\PlaceShipmentButton"/>
        </buttons>
    </settings>
    <dataSource name="polkurier_shipment_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="polkurier/shipment/save"/>
        </settings>
        <aclResource>Polkurier_Shipping::shipment_create</aclResource>
        <dataProvider class="Polkurier\Shipping\Ui\Component\Form\Shipment\DataProvider" name="polkurier_shipment_form_data_source">
            <settings>
                <requestFieldName>order_id</requestFieldName>
                <primaryFieldName>order_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <container name="workspace" sortOrder="10">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="template" xsi:type="string">Polkurier_Shipping/shipment/workspace/column</item>
                <item name="additionalClasses" xsi:type="string">polkurier-workspace</item>
            </item>
        </argument>
        <container name="carriers" sortOrder="10">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="template" xsi:type="string">Polkurier_Shipping/shipment/workspace/column</item>
                    <item name="additionalClasses" xsi:type="string">polkurier-workspace__carriers</item>
                </item>
            </argument>
            <field name="carrier_code" formElement="select" component="Polkurier_Shipping/js/shipment/workspace/carrier-picker" sortOrder="10">
                <settings>
                    <label translate="true">Carrier</label>
                    <elementTmpl>Polkurier_Shipping/shipment/workspace/carrier-picker</elementTmpl>
                    <dataType>text</dataType>
                    <dataScope>carrier_code</dataScope>
                    <validation><rule name="required-entry" xsi:type="boolean">true</rule></validation>
                </settings>
                <formElements>
                    <select>
                        <settings>
                            <options/>
                        </settings>
                    </select>
                </formElements>
            </field>
        </container>
        <container name="main" sortOrder="20">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="template" xsi:type="string">Polkurier_Shipping/shipment/workspace/column</item>
                    <item name="additionalClasses" xsi:type="string">polkurier-workspace__main</item>
                </item>
            </argument>
            <container name="cards" sortOrder="10">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="template" xsi:type="string">Polkurier_Shipping/shipment/workspace/column</item>
                        <item name="additionalClasses" xsi:type="string">polkurier-workspace__cards</item>
                    </item>
                </argument>
                <container name="recipient_card" component="Polkurier_Shipping/js/shipment/workspace/card" sortOrder="10">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="kind" xsi:type="string">recipient</item>
                            <item name="title" xsi:type="string" translate="true">Recipient</item>
                            <item name="modal" xsi:type="string">${ $.ns }.${ $.ns }.recipient_modal</item>
                        </item>
                    </argument>
                </container>
                <container name="shipment_card" component="Polkurier_Shipping/js/shipment/workspace/card" sortOrder="20">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="kind" xsi:type="string">shipment</item>
                            <item name="title" xsi:type="string" translate="true">Shipment and sender</item>
                            <item name="modal" xsi:type="string">${ $.ns }.${ $.ns }.shipment_modal</item>
                        </item>
                    </argument>
                </container>
                <container name="handover_card" component="Polkurier_Shipping/js/shipment/workspace/card" sortOrder="30">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="kind" xsi:type="string">handover</item>
                            <item name="title" xsi:type="string" translate="true">Handover</item>
                            <item name="modal" xsi:type="string">${ $.ns }.${ $.ns }.handover_modal</item>
                        </item>
                    </argument>
                </container>
                <container name="cod_card" component="Polkurier_Shipping/js/shipment/workspace/card" sortOrder="40">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="kind" xsi:type="string">cod</item>
                            <item name="title" xsi:type="string" translate="true">Cash on delivery</item>
                            <item name="modal" xsi:type="string">${ $.ns }.${ $.ns }.cod_modal</item>
                        </item>
                    </argument>
                </container>
                <container name="extras_card" component="Polkurier_Shipping/js/shipment/workspace/card" sortOrder="50">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="kind" xsi:type="string">extras</item>
                            <item name="title" xsi:type="string" translate="true">Insurance and services</item>
                            <item name="modal" xsi:type="string">${ $.ns }.${ $.ns }.extras_modal</item>
                        </item>
                    </argument>
                </container>
                <container name="fields_card" component="Polkurier_Shipping/js/shipment/workspace/card" sortOrder="60">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="kind" xsi:type="string">fields</item>
                            <item name="title" xsi:type="string" translate="true">Carrier-specific fields</item>
                            <item name="modal" xsi:type="string">${ $.ns }.${ $.ns }.fields_modal</item>
                        </item>
                    </argument>
                </container>
            </container>
            <fieldset name="packages" sortOrder="20">
                <settings>
                    <label translate="true">Parcels</label>
                    <additionalClasses>
                        <class name="polkurier-workspace__parcels">true</class>
                    </additionalClasses>
                </settings>
                <dynamicRows name="packs" sortOrder="10">
                    <settings>
                        <addButtonLabel translate="true">Add a parcel</addButtonLabel>
                        <additionalClasses>
                            <class name="admin__field-wide">true</class>
                        </additionalClasses>
                        <componentType>dynamicRows</componentType>
                        <dndConfig>
                            <param name="enabled" xsi:type="boolean">false</param>
                        </dndConfig>
                    </settings>
                    <container name="record" component="Magento_Ui/js/dynamic-rows/record">
                        <argument name="data" xsi:type="array">
                            <item name="config" xsi:type="array">
                                <item name="isTemplate" xsi:type="boolean">true</item>
                                <item name="is_collection" xsi:type="boolean">true</item>
                                <item name="componentType" xsi:type="string">container</item>
                            </item>
                        </argument>
                <field name="template_id" formElement="select" component="Polkurier_Shipping/js/shipment/pack-template" sortOrder="10">
                            <settings>
                                <label translate="true">Template</label>
                                <dataType>text</dataType>
                                <dataScope>template_id</dataScope>
                            </settings>
                            <formElements>
                                <select>
                                    <settings>
                                        <options/>
                                    </settings>
                                </select>
                            </formElements>
                        </field>
                <field name="pack_type" formElement="select" sortOrder="20">
                            <settings>
                                <label translate="true">Type</label>
                                <dataType>text</dataType>
                                <dataScope>pack_type</dataScope>
                                <validation><rule name="required-entry" xsi:type="boolean">true</rule></validation>
                            </settings>
                            <formElements>
                                <select>
                                    <settings>
                                        <options class="Polkurier\Shipping\Model\Config\Source\PackType"/>
                                    </settings>
                                </select>
                            </formElements>
                        </field>
                <field name="length" formElement="input" sortOrder="30">
                            <settings>
                                <label translate="true">Length [cm]</label>
                                <dataType>number</dataType>
                                <dataScope>length</dataScope>
                                <validation><rule name="required-entry" xsi:type="boolean">true</rule><rule name="validate-digits" xsi:type="boolean">true</rule><rule name="validate-greater-than-zero" xsi:type="boolean">true</rule></validation>
                            </settings>
                        </field>
                <field name="width" formElement="input" sortOrder="40">
                            <settings>
                                <label translate="true">Width [cm]</label>
                                <dataType>number</dataType>
                                <dataScope>width</dataScope>
                                <validation><rule name="required-entry" xsi:type="boolean">true</rule><rule name="validate-digits" xsi:type="boolean">true</rule><rule name="validate-greater-than-zero" xsi:type="boolean">true</rule></validation>
                            </settings>
                        </field>
                <field name="height" formElement="input" sortOrder="50">
                            <settings>
                                <label translate="true">Height [cm]</label>
                                <dataType>number</dataType>
                                <dataScope>height</dataScope>
                                <validation><rule name="required-entry" xsi:type="boolean">true</rule><rule name="validate-digits" xsi:type="boolean">true</rule><rule name="validate-greater-than-zero" xsi:type="boolean">true</rule></validation>
                            </settings>
                        </field>
                <field name="weight" formElement="input" sortOrder="60">
                            <settings>
                                <label translate="true">Weight [kg]</label>
                                <dataType>number</dataType>
                                <dataScope>weight</dataScope>
                                <validation><rule name="required-entry" xsi:type="boolean">true</rule><rule name="validate-number" xsi:type="boolean">true</rule><rule name="validate-greater-than-zero" xsi:type="boolean">true</rule></validation>
                            </settings>
                        </field>
                <field name="amount" formElement="input" sortOrder="70">
                            <settings>
                                <label translate="true">Quantity</label>
                                <dataType>number</dataType>
                                <dataScope>amount</dataScope>
                                <validation><rule name="required-entry" xsi:type="boolean">true</rule><rule name="validate-digits" xsi:type="boolean">true</rule><rule name="validate-greater-than-zero" xsi:type="boolean">true</rule></validation>
                            </settings>
                        </field>
                        <actionDelete template="Magento_Backend/dynamic-rows/cells/action-delete" sortOrder="90">
                            <settings>
                                <componentType>actionDelete</componentType>
                                <dataType>text</dataType>
                                <label translate="true">Actions</label>
                            </settings>
                        </actionDelete>
                    </container>
                </dynamicRows>
            </fieldset>
        </container>
        <container name="side" sortOrder="30">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="template" xsi:type="string">Polkurier_Shipping/shipment/workspace/column</item>
                    <item name="additionalClasses" xsi:type="string">polkurier-workspace__side</item>
                </item>
            </argument>
            <container name="summary" component="Polkurier_Shipping/js/shipment/workspace/summary" sortOrder="10"/>
        </container>
    </container>
    <modal name="recipient_modal">
        <settings>
            <options>
                <option name="title" xsi:type="string" translate="true">Recipient</option>
                <option name="type" xsi:type="string">popup</option>
                <option name="modalClass" xsi:type="string">polkurier-workspace-modal</option>
                <option name="buttons" xsi:type="array">
                    <item name="0" xsi:type="array">
                        <item name="text" xsi:type="string" translate="true">Cancel</item>
                        <item name="class" xsi:type="string">action-secondary</item>
                        <item name="actions" xsi:type="array">
                            <item name="0" xsi:type="string">actionCancel</item>
                        </item>
                    </item>
                    <item name="1" xsi:type="array">
                        <item name="text" xsi:type="string" translate="true">Done</item>
                        <item name="class" xsi:type="string">action-primary</item>
                        <item name="actions" xsi:type="array">
                            <item name="0" xsi:type="string">actionDone</item>
                        </item>
                    </item>
                </option>
            </options>
        </settings>
        <fieldset name="recipient" sortOrder="20">
            <settings>
                <label translate="true">Recipient</label>
                </settings>
            <field name="recipient_person" formElement="input" sortOrder="10">
                <settings>
                    <label translate="true">Name</label>
                    <dataType>text</dataType>
                    <dataScope>recipient_person</dataScope>
                    <validation><rule name="required-entry" xsi:type="boolean">true</rule></validation>
                </settings>
            </field>
            <field name="recipient_company" formElement="input" sortOrder="20">
                <settings>
                    <label translate="true">Company</label>
                    <dataType>text</dataType>
                    <dataScope>recipient_company</dataScope>
                </settings>
            </field>
            <field name="recipient_street" formElement="input" sortOrder="30">
                <settings>
                    <label translate="true">Street</label>
                    <dataType>text</dataType>
                    <dataScope>recipient_street</dataScope>
                </settings>
            </field>
            <field name="recipient_house_number" formElement="input" sortOrder="40">
                <settings>
                    <label translate="true">House number</label>
                    <dataType>text</dataType>
                    <dataScope>recipient_house_number</dataScope>
                </settings>
            </field>
            <field name="recipient_flat_number" formElement="input" sortOrder="50">
                <settings>
                    <label translate="true">Flat number</label>
                    <dataType>text</dataType>
                    <dataScope>recipient_flat_number</dataScope>
                </settings>
            </field>
            <field name="recipient_postcode" formElement="input" sortOrder="60">
                <settings>
                    <label translate="true">Postcode</label>
                    <dataType>text</dataType>
                    <dataScope>recipient_postcode</dataScope>
                    <validation><rule name="required-entry" xsi:type="boolean">true</rule></validation>
                </settings>
            </field>
            <field name="recipient_city" formElement="input" sortOrder="70">
                <settings>
                    <label translate="true">City</label>
                    <dataType>text</dataType>
                    <dataScope>recipient_city</dataScope>
                    <validation><rule name="required-entry" xsi:type="boolean">true</rule></validation>
                </settings>
            </field>
            <field name="recipient_country" formElement="select" sortOrder="80">
                <settings>
                    <label translate="true">Country</label>
                    <dataType>text</dataType>
                    <dataScope>recipient_country</dataScope>
                    <validation><rule name="required-entry" xsi:type="boolean">true</rule></validation>
                </settings>
                <formElements>
                    <select>
                        <settings>
                            <options class="Magento\Directory\Model\Config\Source\Country"/>
                        </settings>
                    </select>
                </formElements>
            </field>
            <field name="recipient_phone" formElement="input" sortOrder="90">
                <settings>
                    <label translate="true">Phone</label>
                    <dataType>text</dataType>
                    <dataScope>recipient_phone</dataScope>
                    <validation><rule name="required-entry" xsi:type="boolean">true</rule></validation>
                </settings>
            </field>
            <field name="recipient_email" formElement="input" sortOrder="100">
                <settings>
                    <label translate="true">E-mail</label>
                    <dataType>text</dataType>
                    <dataScope>recipient_email</dataScope>
                    <validation><rule name="validate-email" xsi:type="boolean">true</rule><rule name="required-entry" xsi:type="boolean">true</rule></validation>
                </settings>
            </field>
            <field name="recipient_point_id" formElement="input" component="Polkurier_Shipping/js/shipment/point" sortOrder="110">
                <settings>
                    <label translate="true">Pickup point</label>
                    <dataType>text</dataType>
                    <dataScope>recipient_point_id</dataScope>
                    <notice translate="true">The point the customer chose in checkout, if any.</notice>
                    <imports><link name="visible">${ $.provider }:data.features.point_allowed</link></imports>
                </settings>
            </field>
        </fieldset>
    </modal>
    <modal name="shipment_modal">
        <settings>
            <options>
                <option name="title" xsi:type="string" translate="true">Shipment and sender</option>
                <option name="type" xsi:type="string">popup</option>
                <option name="modalClass" xsi:type="string">polkurier-workspace-modal</option>
                <option name="buttons" xsi:type="array">
                    <item name="0" xsi:type="array">
                        <item name="text" xsi:type="string" translate="true">Cancel</item>
                        <item name="class" xsi:type="string">action-secondary</item>
                        <item name="actions" xsi:type="array">
                            <item name="0" xsi:type="string">actionCancel</item>
                        </item>
                    </item>
                    <item name="1" xsi:type="array">
                        <item name="text" xsi:type="string" translate="true">Done</item>
                        <item name="class" xsi:type="string">action-primary</item>
                        <item name="actions" xsi:type="array">
                            <item name="0" xsi:type="string">actionDone</item>
                        </item>
                    </item>
                </option>
            </options>
        </settings>
        <fieldset name="shipment" sortOrder="10">
            <settings>
                <label translate="true">Shipment</label>
                </settings>
            <field name="shipment_type" formElement="select" sortOrder="20">
                <settings>
                    <label translate="true">Shipment type</label>
                    <dataType>text</dataType>
                    <dataScope>shipment_type</dataScope>
                    <validation><rule name="required-entry" xsi:type="boolean">true</rule></validation>
                </settings>
                <formElements>
                    <select>
                        <settings>
                            <options class="Polkurier\Shipping\Model\Config\Source\ShipmentType"/>
                        </settings>
                    </select>
                </formElements>
            </field>
            <field name="description" formElement="input" sortOrder="30">
                <settings>
                    <label translate="true">Description</label>
                    <dataType>text</dataType>
                    <dataScope>description</dataScope>
                    <validation><rule name="required-entry" xsi:type="boolean">true</rule></validation>
                    <notice translate="true">Printed on the label; up to 30 characters.</notice>
                </settings>
            </field>
            <field name="sender_address_id" formElement="select" sortOrder="40">
                <settings>
                    <label translate="true">Sender</label>
                    <dataType>text</dataType>
                    <dataScope>sender_address_id</dataScope>
                </settings>
                <formElements>
                    <select>
                        <settings>
                            <options/>
                        </settings>
                    </select>
                </formElements>
            </field>
        </fieldset>
    </modal>
    <modal name="handover_modal">
        <settings>
            <options>
                <option name="title" xsi:type="string" translate="true">Handover to the carrier</option>
                <option name="type" xsi:type="string">popup</option>
                <option name="modalClass" xsi:type="string">polkurier-workspace-modal</option>
                <option name="buttons" xsi:type="array">
                    <item name="0" xsi:type="array">
                        <item name="text" xsi:type="string" translate="true">Cancel</item>
                        <item name="class" xsi:type="string">action-secondary</item>
                        <item name="actions" xsi:type="array">
                            <item name="0" xsi:type="string">actionCancel</item>
                        </item>
                    </item>
                    <item name="1" xsi:type="array">
                        <item name="text" xsi:type="string" translate="true">Done</item>
                        <item name="class" xsi:type="string">action-primary</item>
                        <item name="actions" xsi:type="array">
                            <item name="0" xsi:type="string">actionDone</item>
                        </item>
                    </item>
                </option>
            </options>
        </settings>
        <fieldset name="pickup" sortOrder="70">
            <settings>
                <label translate="true">Handover to the carrier</label>
                </settings>
            <field name="pickup_mode" formElement="select" sortOrder="10">
                <settings>
                    <label translate="true">Handover</label>
                    <dataType>text</dataType>
                    <dataScope>pickup_mode</dataScope>
                </settings>
                <formElements>
                    <select>
                        <settings>
                            <options class="Polkurier\Shipping\Model\Config\Source\PickupMode"/>
                        </settings>
                    </select>
                </formElements>
            </field>
            <field name="pickup_date" formElement="input" component="Polkurier_Shipping/js/shipment/pickup-field" sortOrder="20">
                <settings>
                    <label translate="true">Collection date (YYYY-MM-DD)</label>
                    <dataType>text</dataType>
                    <dataScope>pickup_date</dataScope>
                </settings>
            </field>
            <field name="pickup_time_from" formElement="input" component="Polkurier_Shipping/js/shipment/pickup-field" sortOrder="30">
                <settings>
                    <label translate="true">From (HH:MM)</label>
                    <dataType>text</dataType>
                    <dataScope>pickup_time_from</dataScope>
                </settings>
            </field>
            <field name="pickup_time_to" formElement="input" component="Polkurier_Shipping/js/shipment/pickup-field" sortOrder="40">
                <settings>
                    <label translate="true">To (HH:MM)</label>
                    <dataType>text</dataType>
                    <dataScope>pickup_time_to</dataScope>
                </settings>
            </field>
            <container name="pickup_times" component="Polkurier_Shipping/js/shipment/pickup-times" sortOrder="50">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="template" xsi:type="string">Polkurier_Shipping/shipment/pickup-times</item>
                    </item>
                </argument>
            </container>
        </fieldset>
    </modal>
    <modal name="cod_modal">
        <settings>
            <options>
                <option name="title" xsi:type="string" translate="true">Cash on delivery</option>
                <option name="type" xsi:type="string">popup</option>
                <option name="modalClass" xsi:type="string">polkurier-workspace-modal</option>
                <option name="buttons" xsi:type="array">
                    <item name="0" xsi:type="array">
                        <item name="text" xsi:type="string" translate="true">Cancel</item>
                        <item name="class" xsi:type="string">action-secondary</item>
                        <item name="actions" xsi:type="array">
                            <item name="0" xsi:type="string">actionCancel</item>
                        </item>
                    </item>
                    <item name="1" xsi:type="array">
                        <item name="text" xsi:type="string" translate="true">Done</item>
                        <item name="class" xsi:type="string">action-primary</item>
                        <item name="actions" xsi:type="array">
                            <item name="0" xsi:type="string">actionDone</item>
                        </item>
                    </item>
                </option>
            </options>
        </settings>
        <fieldset name="cod" sortOrder="40">
            <settings>
                <label translate="true">Cash on delivery</label>
                <imports><link name="visible">${ $.provider }:data.features.cod</link></imports>
            </settings>
            <field name="cod_amount" formElement="input" sortOrder="10">
                <settings>
                    <label translate="true">Amount to collect</label>
                    <dataType>number</dataType>
                    <dataScope>cod_amount</dataScope>
                    <validation><rule name="validate-number" xsi:type="boolean">true</rule><rule name="validate-zero-or-greater" xsi:type="boolean">true</rule></validation>
                    <notice translate="true">0 or empty: no cash on delivery.</notice>
                </settings>
            </field>
            <field name="cod_type" formElement="select" sortOrder="20">
                <settings>
                    <label translate="true">Payout time</label>
                    <dataType>text</dataType>
                    <dataScope>cod_type</dataScope>
                </settings>
                <formElements>
                    <select>
                        <settings>
                            <options class="Polkurier\Shipping\Model\Config\Source\CodType"/>
                        </settings>
                    </select>
                </formElements>
            </field>
            <field name="cod_return_type" formElement="select" sortOrder="30">
                <settings>
                    <label translate="true">Paid out to</label>
                    <dataType>text</dataType>
                    <dataScope>cod_return_type</dataScope>
                </settings>
                <formElements>
                    <select>
                        <settings>
                            <options class="Polkurier\Shipping\Model\Config\Source\CodReturnType"/>
                        </settings>
                    </select>
                </formElements>
            </field>
            <field name="cod_bank_account_id" formElement="select" sortOrder="40">
                <settings>
                    <label translate="true">Bank account</label>
                    <dataType>text</dataType>
                    <dataScope>cod_bank_account_id</dataScope>
                </settings>
                <formElements>
                    <select>
                        <settings>
                            <options/>
                        </settings>
                    </select>
                </formElements>
            </field>
        </fieldset>
    </modal>
    <modal name="extras_modal">
        <settings>
            <options>
                <option name="title" xsi:type="string" translate="true">Insurance and services</option>
                <option name="type" xsi:type="string">popup</option>
                <option name="modalClass" xsi:type="string">polkurier-workspace-modal</option>
                <option name="buttons" xsi:type="array">
                    <item name="0" xsi:type="array">
                        <item name="text" xsi:type="string" translate="true">Cancel</item>
                        <item name="class" xsi:type="string">action-secondary</item>
                        <item name="actions" xsi:type="array">
                            <item name="0" xsi:type="string">actionCancel</item>
                        </item>
                    </item>
                    <item name="1" xsi:type="array">
                        <item name="text" xsi:type="string" translate="true">Done</item>
                        <item name="class" xsi:type="string">action-primary</item>
                        <item name="actions" xsi:type="array">
                            <item name="0" xsi:type="string">actionDone</item>
                        </item>
                    </item>
                </option>
            </options>
        </settings>
        <fieldset name="insurance" sortOrder="50">
            <settings>
                <label translate="true">Insurance</label>
                <imports><link name="visible">${ $.provider }:data.features.insurance</link></imports>
            </settings>
            <field name="insurance_amount" formElement="input" sortOrder="10">
                <settings>
                    <label translate="true">Declared value</label>
                    <dataType>number</dataType>
                    <dataScope>insurance_amount</dataScope>
                    <validation><rule name="validate-number" xsi:type="boolean">true</rule><rule name="validate-zero-or-greater" xsi:type="boolean">true</rule></validation>
                    <notice translate="true">0 or empty: no insurance.</notice>
                </settings>
            </field>
        </fieldset>
        <fieldset name="services" sortOrder="60">
            <settings>
                <label translate="true">Additional services</label>
            </settings>
            <field name="services" formElement="checkboxset" component="Polkurier_Shipping/js/shipment/services" sortOrder="10">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="template" xsi:type="string">Polkurier_Shipping/shipment/services</item>
                    </item>
                </argument>
                <settings>
                    <label translate="true">Additional services</label>
                    <dataType>text</dataType>
                    <dataScope>services</dataScope>
                </settings>
                <formElements>
                    <checkboxset>
                        <settings>
                            <options class="Polkurier\Shipping\Model\Config\Source\AdditionalService"/>
                        </settings>
                    </checkboxset>
                </formElements>
            </field>
            <field name="cover_address_id" formElement="select" sortOrder="20">
                <settings>
                    <label translate="true">Cover address</label>
                    <dataType>text</dataType>
                    <dataScope>cover_address_id</dataScope>
                    <notice translate="true">Returns go to this address instead of the sender's.</notice>
                </settings>
                <formElements>
                    <select>
                        <settings>
                            <options/>
                        </settings>
                    </select>
                </formElements>
            </field>
        </fieldset>
    </modal>
    <modal name="fields_modal">
        <settings>
            <options>
                <option name="title" xsi:type="string" translate="true">Carrier-specific fields</option>
                <option name="type" xsi:type="string">popup</option>
                <option name="modalClass" xsi:type="string">polkurier-workspace-modal</option>
                <option name="buttons" xsi:type="array">
                    <item name="0" xsi:type="array">
                        <item name="text" xsi:type="string" translate="true">Cancel</item>
                        <item name="class" xsi:type="string">action-secondary</item>
                        <item name="actions" xsi:type="array">
                            <item name="0" xsi:type="string">actionCancel</item>
                        </item>
                    </item>
                    <item name="1" xsi:type="array">
                        <item name="text" xsi:type="string" translate="true">Done</item>
                        <item name="class" xsi:type="string">action-primary</item>
                        <item name="actions" xsi:type="array">
                            <item name="0" xsi:type="string">actionDone</item>
                        </item>
                    </item>
                </option>
            </options>
        </settings>
        <fieldset name="additional" sortOrder="80">
            <settings>
                <label translate="true">Carrier-specific fields</label>
                <imports><link name="visible">${ $.provider }:data.features.has_fields</link></imports>
            </settings>
            <container name="additional_fields" component="Polkurier_Shipping/js/shipment/additional-fields" sortOrder="10">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="template" xsi:type="string">Polkurier_Shipping/shipment/additional-fields</item>
                    </item>
                </argument>
            </container>
        </fieldset>
    </modal>
</form>
