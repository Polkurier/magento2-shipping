<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <carriers>
            <polkurier>
                <active>0</active>
                <sandbox_mode>0</sandbox_mode>
                <customer_id backend_model="Magento\Config\Model\Config\Backend\Encrypted" />
                <api_token backend_model="Magento\Config\Model\Config\Backend\Encrypted" />
                <home_country_id>PL</home_country_id>
                <model>Polkurier\Shipping\Model\PolkurierCarrier</model>
                <map>
                    <default_latitude>52.2252606</default_latitude>
                    <default_longitude>20.9986249</default_longitude>
                    <default_zoom>13</default_zoom>
                    <show_list>1</show_list>
                    <show_search_input>1</show_search_input>
                    <required_point_functions>collect</required_point_functions>
                </map>
            </polkurier>
        </carriers>
    </default>
</config>
