<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <!-- The merchant's settings per Polkurier carrier: visibility, label and price in checkout -->
    <table name="polkurier_carrier_config" resource="default" engine="innodb" comment="Polkurier carrier settings">
        <column xsi:type="int" name="config_id" identity="true" nullable="false" unsigned="true" />
        <column xsi:type="varchar" name="carrier_code" nullable="false" length="64" />
        <column xsi:type="varchar" name="carrier_name" nullable="false" length="255"
                comment="Name reported by the API" />
        <column xsi:type="varchar" name="custom_label" nullable="true" length="255" />
        <column xsi:type="varchar" name="logo" nullable="true" length="255"
                comment="Logo shown next to the method in checkout, relative to the media directory" />
        <column xsi:type="smallint" name="active" nullable="false" unsigned="true" default="0" />
        <column xsi:type="int" name="sort_order" nullable="false" default="0" />
        <column xsi:type="varchar" name="pricing_model" nullable="false" length="32" default="FIXED" />
        <column xsi:type="text" name="price_info" nullable="true" comment="JSON, shape depends on pricing_model" />
        <column xsi:type="smallint" name="available" nullable="false" unsigned="true" default="1"
                comment="Whether the account still offers the carrier" />
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" />
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="config_id" />
        </constraint>
        <constraint xsi:type="unique" referenceId="POLKURIER_CARRIER_CONFIG_CARRIER_CODE">
            <column name="carrier_code" />
        </constraint>
    </table>
    <table name="polkurier_carrier_label" resource="default" engine="innodb"
           comment="Polkurier carrier labels per store view">
        <column xsi:type="int" name="config_id" nullable="false" unsigned="true" />
        <column xsi:type="smallint" name="store_id" nullable="false" unsigned="true" />
        <column xsi:type="varchar" name="label" nullable="false" length="255" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="config_id" />
            <column name="store_id" />
        </constraint>
        <constraint xsi:type="foreign"
                    referenceId="POLKURIER_CARRIER_LABEL_CONFIG_ID_POLKURIER_CARRIER_CONFIG_CONFIG_ID"
                    table="polkurier_carrier_label" column="config_id" referenceTable="polkurier_carrier_config"
                    referenceColumn="config_id" onDelete="CASCADE" />
        <constraint xsi:type="foreign" referenceId="POLKURIER_CARRIER_LABEL_STORE_ID_STORE_STORE_ID"
                    table="polkurier_carrier_label" column="store_id" referenceTable="store"
                    referenceColumn="store_id" onDelete="CASCADE" />
    </table>

    <!-- Address book, mirrored with the Polkurier account's -->
    <table name="polkurier_address" resource="default" engine="innodb" comment="Polkurier address book">
        <column xsi:type="int" name="address_id" identity="true" nullable="false" unsigned="true" />
        <column xsi:type="varbinary" name="ext_id" nullable="true" length="64"
                comment="Id in Polkurier; its case matters" />
        <column xsi:type="varchar" name="name" nullable="false" length="255" />
        <column xsi:type="varchar" name="type" nullable="false" length="16" default="SENDER" />
        <column xsi:type="varchar" name="person" nullable="false" length="255" />
        <column xsi:type="varchar" name="company" nullable="true" length="255" />
        <column xsi:type="varchar" name="street" nullable="false" length="255" />
        <column xsi:type="varchar" name="house_number" nullable="false" length="32" />
        <column xsi:type="varchar" name="flat_number" nullable="true" length="32" />
        <column xsi:type="varchar" name="city" nullable="false" length="255" />
        <column xsi:type="varchar" name="postcode" nullable="false" length="32" />
        <column xsi:type="varchar" name="province" nullable="true" length="64" />
        <column xsi:type="varchar" name="country" nullable="false" length="2" default="PL" />
        <column xsi:type="varchar" name="email" nullable="false" length="255" />
        <column xsi:type="varchar" name="phone" nullable="false" length="64" />
        <column xsi:type="smallint" name="is_default" nullable="false" unsigned="true" default="0" />
        <column xsi:type="smallint" name="is_cover" nullable="false" unsigned="true" default="0"
                comment="Usable as the cover (return) address" />
        <column xsi:type="smallint" name="shared" nullable="false" unsigned="true" default="0" />
        <column xsi:type="varchar" name="sync_state" nullable="false" length="16" default="pending" />
        <column xsi:type="text" name="sync_error" nullable="true" />
        <column xsi:type="varchar" name="remote_hash" nullable="true" length="64" />
        <column xsi:type="datetime" name="remote_updated_at" nullable="true" />
        <column xsi:type="datetime" name="synced_at" nullable="true" />
        <column xsi:type="datetime" name="deleted_at" nullable="true" comment="Deleted locally, awaiting sync" />
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" />
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="address_id" />
        </constraint>
        <constraint xsi:type="unique" referenceId="POLKURIER_ADDRESS_EXT_ID">
            <column name="ext_id" />
        </constraint>
    </table>

    <!-- Bank accounts cash on delivery is paid out to, mirrored from the Polkurier account -->
    <table name="polkurier_bank_account" resource="default" engine="innodb" comment="Polkurier bank accounts">
        <column xsi:type="int" name="account_id" identity="true" nullable="false" unsigned="true" />
        <column xsi:type="varbinary" name="ext_id" nullable="true" length="64"
                comment="Id in Polkurier; its case matters" />
        <column xsi:type="varchar" name="name" nullable="false" length="255" />
        <column xsi:type="varchar" name="number" nullable="false" length="64" />
        <column xsi:type="smallint" name="is_default" nullable="false" unsigned="true" default="0" />
        <column xsi:type="varchar" name="sync_state" nullable="false" length="16" default="pending" />
        <column xsi:type="text" name="sync_error" nullable="true" />
        <column xsi:type="varchar" name="remote_hash" nullable="true" length="64" />
        <column xsi:type="datetime" name="remote_updated_at" nullable="true" />
        <column xsi:type="datetime" name="synced_at" nullable="true" />
        <column xsi:type="datetime" name="deleted_at" nullable="true" comment="Deleted locally, awaiting sync" />
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" />
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="account_id" />
        </constraint>
        <constraint xsi:type="unique" referenceId="POLKURIER_BANK_ACCOUNT_EXT_ID">
            <column name="ext_id" />
        </constraint>
    </table>

    <!-- Parcel templates, mirrored with the Polkurier account's -->
    <table name="polkurier_pack_template" resource="default" engine="innodb" comment="Polkurier pack templates">
        <column xsi:type="int" name="template_id" identity="true" nullable="false" unsigned="true" />
        <column xsi:type="varbinary" name="ext_id" nullable="true" length="64"
                comment="Id in Polkurier; its case matters" />
        <column xsi:type="varchar" name="name" nullable="false" length="255" />
        <column xsi:type="text" name="description" nullable="true" />
        <column xsi:type="varchar" name="pack_type" nullable="false" length="16" default="ST" />
        <column xsi:type="int" name="length" nullable="false" unsigned="true" />
        <column xsi:type="int" name="width" nullable="false" unsigned="true" />
        <column xsi:type="int" name="height" nullable="false" unsigned="true" />
        <column xsi:type="decimal" name="weight" scale="3" precision="12" unsigned="true" nullable="false" />
        <column xsi:type="decimal" name="tare" scale="3" precision="12" unsigned="true" nullable="true"
                comment="What the packaging itself weighs, kg; Magento only" />
        <column xsi:type="decimal" name="cod_amount" scale="2" precision="12" unsigned="true" nullable="false"
                default="0" />
        <column xsi:type="decimal" name="insurance_amount" scale="2" precision="12" unsigned="true" nullable="false"
                default="0" />
        <column xsi:type="varchar" name="carrier_code" nullable="true" length="64" />
        <column xsi:type="text" name="services" nullable="true" comment="Comma-separated service codes" />
        <column xsi:type="smallint" name="is_default" nullable="false" unsigned="true" default="0" />
        <column xsi:type="varchar" name="sync_state" nullable="false" length="16" default="pending" />
        <column xsi:type="text" name="sync_error" nullable="true" />
        <column xsi:type="varchar" name="remote_hash" nullable="true" length="64" />
        <column xsi:type="datetime" name="remote_updated_at" nullable="true" />
        <column xsi:type="datetime" name="synced_at" nullable="true" />
        <column xsi:type="datetime" name="deleted_at" nullable="true" comment="Deleted locally, awaiting sync" />
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" />
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="template_id" />
        </constraint>
        <constraint xsi:type="unique" referenceId="POLKURIER_PACK_TEMPLATE_EXT_ID">
            <column name="ext_id" />
        </constraint>
    </table>

    <!-- The pickup point chosen in checkout -->
    <table name="polkurier_quote_point" resource="checkout" engine="innodb" comment="Polkurier pickup point on a quote">
        <column xsi:type="int" name="entity_id" identity="true" nullable="false" unsigned="true" />
        <column xsi:type="int" name="quote_id" nullable="false" unsigned="true" />
        <column xsi:type="int" name="quote_address_id" nullable="false" unsigned="true" default="0"
                comment="The shipping address in multi-address checkout; 0 in the regular checkout" />
        <column xsi:type="varchar" name="method_code" nullable="false" length="64" />
        <column xsi:type="varchar" name="point_id" nullable="false" length="64" />
        <column xsi:type="varchar" name="point_label" nullable="true" length="512" />
        <column xsi:type="smallint" name="point_cod" nullable="true" unsigned="true"
                comment="Whether the point accepts cash on delivery, as reported by the API; null when not known" />
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id" />
        </constraint>
        <constraint xsi:type="unique" referenceId="POLKURIER_QUOTE_POINT_QUOTE_ID_QUOTE_ADDRESS_ID">
            <column name="quote_id" />
            <column name="quote_address_id" />
        </constraint>
        <constraint xsi:type="foreign" referenceId="POLKURIER_QUOTE_POINT_QUOTE_ID_QUOTE_ENTITY_ID"
                    table="polkurier_quote_point" column="quote_id" referenceTable="quote"
                    referenceColumn="entity_id" onDelete="CASCADE" />
    </table>

    <!-- The pickup point carried onto the order -->
    <table name="polkurier_order_point" resource="sales" engine="innodb" comment="Polkurier pickup point on an order">
        <column xsi:type="int" name="order_id" nullable="false" unsigned="true" />
        <column xsi:type="varchar" name="method_code" nullable="false" length="64" />
        <column xsi:type="varchar" name="point_id" nullable="false" length="64" />
        <column xsi:type="varchar" name="point_label" nullable="true" length="512" />
        <column xsi:type="smallint" name="point_cod" nullable="true" unsigned="true"
                comment="Whether the point accepts cash on delivery; null when not known" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="order_id" />
        </constraint>
        <constraint xsi:type="foreign" referenceId="POLKURIER_ORDER_POINT_ORDER_ID_SALES_ORDER_ENTITY_ID"
                    table="polkurier_order_point" column="order_id" referenceTable="sales_order"
                    referenceColumn="entity_id" onDelete="CASCADE" />
    </table>

    <!-- The shipping the customer chose, kept once the order's shipping is changed to match its
         Polkurier order -->
    <table name="polkurier_order_shipping_choice" resource="sales" engine="innodb"
           comment="Shipping the customer chose for a Polkurier order">
        <column xsi:type="int" name="order_id" nullable="false" unsigned="true" />
        <column xsi:type="varchar" name="shipping_method" nullable="true" length="120" />
        <column xsi:type="varchar" name="shipping_description" nullable="true" length="255" />
        <column xsi:type="varchar" name="point_method_code" nullable="true" length="64" />
        <column xsi:type="varchar" name="point_id" nullable="true" length="64" />
        <column xsi:type="varchar" name="point_label" nullable="true" length="512" />
        <column xsi:type="smallint" name="point_cod" nullable="true" unsigned="true"
                comment="Whether the point accepts cash on delivery; null when not known" />
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="order_id" />
        </constraint>
        <constraint xsi:type="foreign" referenceId="POLKURIER_ORDER_SHPP_CHOICE_ORDER_ID_SALES_ORDER_ENTT_ID"
                    table="polkurier_order_shipping_choice" column="order_id" referenceTable="sales_order"
                    referenceColumn="entity_id" onDelete="CASCADE" />
    </table>

    <!-- A Polkurier order placed for a Magento order -->
    <table name="polkurier_shipment" resource="sales" engine="innodb" comment="Polkurier orders">
        <column xsi:type="int" name="entity_id" identity="true" nullable="false" unsigned="true" />
        <column xsi:type="int" name="order_id" nullable="false" unsigned="true" />
        <column xsi:type="smallint" name="store_id" nullable="true" unsigned="true" />
        <column xsi:type="int" name="shipment_id" nullable="true" unsigned="true" comment="Magento shipment" />
        <column xsi:type="varchar" name="state" nullable="false" length="16" default="pending"
                comment="pending, created, unknown, failed, cancelled" />
        <column xsi:type="varchar" name="polkurier_number" nullable="true" length="64" />
        <column xsi:type="varchar" name="carrier_code" nullable="false" length="64" />
        <column xsi:type="varchar" name="description" nullable="false" length="64" />
        <column xsi:type="varchar" name="recipient_postcode" nullable="true" length="32" />
        <column xsi:type="varchar" name="recipient_phone" nullable="true" length="64" />
        <column xsi:type="smallint" name="pack_count" nullable="false" unsigned="true" default="1" />
        <column xsi:type="text" name="waybills" nullable="true" comment="Comma-separated waybill numbers" />
        <column xsi:type="varchar" name="status_code" nullable="true" length="16" />
        <column xsi:type="varchar" name="status_label" nullable="true" length="255" />
        <column xsi:type="datetime" name="status_date" nullable="true" />
        <column xsi:type="datetime" name="delivered_at" nullable="true" />
        <column xsi:type="varchar" name="tracking_url" nullable="true" length="1024" />
        <column xsi:type="decimal" name="price_net" scale="2" precision="12" nullable="true" />
        <column xsi:type="decimal" name="price_gross" scale="2" precision="12" nullable="true" />
        <column xsi:type="decimal" name="insurance_amount" scale="2" precision="12" nullable="true" />
        <column xsi:type="decimal" name="cod_amount" scale="2" precision="12" nullable="true" />
        <column xsi:type="varchar" name="cod_status" nullable="true" length="32" />
        <column xsi:type="smallint" name="multi_pickup" nullable="false" unsigned="true" default="0"
                comment="Created for a later collective pickup" />
        <column xsi:type="smallint" name="pickup_booked" nullable="false" unsigned="true" default="0" />
        <column xsi:type="smallint" name="is_final" nullable="false" unsigned="true" default="0"
                comment="Statuses can no longer change: no more refreshing" />
        <column xsi:type="datetime" name="status_checked_at" nullable="true"
                comment="Last time the statuses were read, whether or not they changed" />
        <column xsi:type="mediumtext" name="request" nullable="true" comment="The create_order payload sent, as JSON" />
        <column xsi:type="mediumtext" name="draft" nullable="true"
                comment="The shipment as filled in to place it, as JSON: what sending it again starts from" />
        <column xsi:type="text" name="ship_items" nullable="true"
                comment="Quantities to ship in Magento by order item id, as JSON; empty for everything left" />
        <column xsi:type="text" name="ship_packages" nullable="true"
                comment="Packages of the Magento shipment, as Magento keeps them, as JSON" />
        <column xsi:type="int" name="target_shipment_id" nullable="true" unsigned="true"
                comment="Existing Magento shipment to go on once placed, instead of shipping items" />
        <column xsi:type="varchar" name="external_order_id" nullable="true" length="50"
                comment="Sent to Polkurier as external_order_id: the Magento shipment or order number" />
        <column xsi:type="varchar" name="reserved_shipment_number" nullable="true" length="50"
                comment="Number taken for the Magento shipment to be created, sent as its external_order_id" />
        <column xsi:type="mediumtext" name="details" nullable="true"
                comment="Local copy of the order as Polkurier reports it, as JSON" />
        <column xsi:type="datetime" name="details_synced_at" nullable="true" />
        <column xsi:type="mediumtext" name="tracking" nullable="true"
                comment="Local copy of the carrier's scan history, as JSON" />
        <column xsi:type="datetime" name="tracking_synced_at" nullable="true" />
        <column xsi:type="text" name="last_error" nullable="true" />
        <column xsi:type="datetime" name="attention_notified_at" nullable="true"
                comment="When the admin was notified that it needs attention; cleared by a new attempt" />
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" />
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id" />
        </constraint>
        <constraint xsi:type="unique" referenceId="POLKURIER_SHIPMENT_POLKURIER_NUMBER">
            <column name="polkurier_number" />
        </constraint>
        <!-- A Magento shipment keeps every Polkurier order it has had: at most one placed, any
             number cancelled before it -->
        <index referenceId="POLKURIER_SHIPMENT_MAGENTO_SHIPMENT" indexType="btree">
            <column name="shipment_id" />
        </index>
        <index referenceId="POLKURIER_SHIPMENT_ORDER_ID" indexType="btree">
            <column name="order_id" />
        </index>
        <index referenceId="POLKURIER_SHIPMENT_STATE_IS_FINAL_STATUS_CHECKED_AT" indexType="btree">
            <column name="state" />
            <column name="is_final" />
            <column name="status_checked_at" />
        </index>
        <constraint xsi:type="foreign" referenceId="POLKURIER_SHIPMENT_ORDER_ID_SALES_ORDER_ENTITY_ID"
                    table="polkurier_shipment" column="order_id" referenceTable="sales_order"
                    referenceColumn="entity_id" onDelete="CASCADE" />
        <constraint xsi:type="foreign" referenceId="POLKURIER_SHIPMENT_SHIPMENT_ID_SALES_SHIPMENT_ENTITY_ID"
                    table="polkurier_shipment" column="shipment_id" referenceTable="sales_shipment"
                    referenceColumn="entity_id" onDelete="SET NULL" />
        <constraint xsi:type="foreign" referenceId="POLKURIER_SHIPMENT_TARGET_SHIPMENT_ID_SALES_SHIPMENT_ENTITY_ID"
                    table="polkurier_shipment" column="target_shipment_id" referenceTable="sales_shipment"
                    referenceColumn="entity_id" onDelete="SET NULL" />
        <constraint xsi:type="foreign" referenceId="POLKURIER_SHIPMENT_STORE_ID_STORE_STORE_ID"
                    table="polkurier_shipment" column="store_id" referenceTable="store"
                    referenceColumn="store_id" onDelete="SET NULL" />
    </table>
    <!-- The Polkurier orders lists find their orders by a shipping method starting with "polkurier_" -->
    <table name="sales_order" resource="sales">
        <index referenceId="SALES_ORDER_SHIPPING_METHOD" indexType="btree">
            <column name="shipping_method" />
        </index>
    </table>
</schema>
