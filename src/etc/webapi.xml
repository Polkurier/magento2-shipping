<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/polkurier/orders/:orderId/draft" method="GET">
        <service class="Polkurier\Shipping\Api\ShipmentManagementInterface" method="getDefaultDraft"/>
        <resources>
            <resource ref="Polkurier_Shipping::shipment_create"/>
        </resources>
    </route>
    <route url="/V1/polkurier/orders/:orderId/shipments" method="POST">
        <service class="Polkurier\Shipping\Api\ShipmentManagementInterface" method="create"/>
        <resources>
            <resource ref="Polkurier_Shipping::shipment_create"/>
        </resources>
    </route>
    <route url="/V1/polkurier/shipments/:shipmentId/reconcile" method="POST">
        <service class="Polkurier\Shipping\Api\ShipmentManagementInterface" method="reconcile"/>
        <resources>
            <resource ref="Polkurier_Shipping::shipment_create"/>
        </resources>
    </route>
    <route url="/V1/polkurier/shipments/:shipmentId/adopt" method="POST">
        <service class="Polkurier\Shipping\Api\ShipmentManagementInterface" method="adopt"/>
        <resources>
            <resource ref="Polkurier_Shipping::shipment_create"/>
        </resources>
    </route>
    <route url="/V1/polkurier/shipments/:shipmentId/ship" method="POST">
        <service class="Polkurier\Shipping\Api\ShipmentManagementInterface" method="shipOrder"/>
        <resources>
            <resource ref="Polkurier_Shipping::shipment_create"/>
        </resources>
    </route>
    <route url="/V1/polkurier/shipments/:shipmentId/status" method="POST">
        <service class="Polkurier\Shipping\Api\ShipmentManagementInterface" method="refreshStatus"/>
        <resources>
            <resource ref="Polkurier_Shipping::shipments"/>
        </resources>
    </route>
    <route url="/V1/polkurier/shipments/:shipmentId/cancel" method="POST">
        <service class="Polkurier\Shipping\Api\ShipmentManagementInterface" method="cancel"/>
        <resources>
            <resource ref="Polkurier_Shipping::shipment_cancel"/>
        </resources>
    </route>
    <route url="/V1/polkurier/shipments/:id" method="GET">
        <service class="Polkurier\Shipping\Api\ShipmentRepositoryInterface" method="get"/>
        <resources>
            <resource ref="Polkurier_Shipping::shipments"/>
        </resources>
    </route>
    <route url="/V1/polkurier/shipments" method="GET">
        <service class="Polkurier\Shipping\Api\ShipmentRepositoryInterface" method="getList"/>
        <resources>
            <resource ref="Polkurier_Shipping::shipments"/>
        </resources>
    </route>
</routes>
