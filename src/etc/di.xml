<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Polkurier SDK -->
    <preference for="Polkurier\Webservice\Serializer\SerializerProviderInterface"
                type="Polkurier\Shipping\Model\Sdk\SerializerProvider" />
    <preference for="Polkurier\Webservice\Api\Validation\ValidatorInterface"
                type="Polkurier\Shipping\Model\Sdk\Validator" />
    <type name="Polkurier\Shipping\Model\Sdk\SerializerProvider" shared="true" />
    <type name="Polkurier\Shipping\Model\Sdk\ClientPool">
        <arguments>
            <argument name="logger" xsi:type="object">Polkurier\Shipping\Logger\Logger</argument>
        </arguments>
    </type>
    <virtualType name="Polkurier\Shipping\Logger\Logger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">polkurier</argument>
            <argument name="handlers" xsi:type="array">
                <item name="file" xsi:type="object">Polkurier\Shipping\Logger\Handler</item>
            </argument>
            <argument name="processors" xsi:type="array">
                <item name="redact_token" xsi:type="object">Polkurier\Shipping\Logger\TokenRedactingProcessor</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- System configuration -->
    <type name="Magento\Config\Model\Config\TypePool">
        <arguments>
            <argument name="sensitive" xsi:type="array">
                <item name="carriers/polkurier/general/customer_id" xsi:type="string">1</item>
                <item name="carriers/polkurier/general/api_token" xsi:type="string">1</item>
            </argument>
        </arguments>
    </type>

    <!-- Service contracts -->
    <preference for="Polkurier\Shipping\Api\Data\AddressInterface" type="Polkurier\Shipping\Model\Address" />
    <preference for="Polkurier\Shipping\Api\Data\AddressSearchResultsInterface" type="Polkurier\Shipping\Model\SearchResults\AddressSearchResults" />
    <preference for="Polkurier\Shipping\Api\AddressRepositoryInterface" type="Polkurier\Shipping\Model\Repository\AddressRepository" />
    <preference for="Polkurier\Shipping\Api\Data\BankAccountInterface" type="Polkurier\Shipping\Model\BankAccount" />
    <preference for="Polkurier\Shipping\Api\Data\BankAccountSearchResultsInterface" type="Polkurier\Shipping\Model\SearchResults\BankAccountSearchResults" />
    <preference for="Polkurier\Shipping\Api\BankAccountRepositoryInterface" type="Polkurier\Shipping\Model\Repository\BankAccountRepository" />
    <preference for="Polkurier\Shipping\Api\Data\PackTemplateInterface" type="Polkurier\Shipping\Model\PackTemplate" />
    <preference for="Polkurier\Shipping\Api\Data\PackTemplateSearchResultsInterface" type="Polkurier\Shipping\Model\SearchResults\PackTemplateSearchResults" />
    <preference for="Polkurier\Shipping\Api\PackTemplateRepositoryInterface" type="Polkurier\Shipping\Model\Repository\PackTemplateRepository" />
    <preference for="Polkurier\Shipping\Api\Data\CarrierConfigInterface" type="Polkurier\Shipping\Model\CarrierConfig" />
    <preference for="Polkurier\Shipping\Api\Data\CarrierConfigSearchResultsInterface" type="Polkurier\Shipping\Model\SearchResults\CarrierConfigSearchResults" />
    <preference for="Polkurier\Shipping\Api\CarrierConfigRepositoryInterface" type="Polkurier\Shipping\Model\Repository\CarrierConfigRepository" />
    <preference for="Polkurier\Shipping\Api\Data\CarrierLabelInterface" type="Polkurier\Shipping\Model\CarrierLabel" />
    <preference for="Polkurier\Shipping\Api\Data\ShipmentInterface" type="Polkurier\Shipping\Model\Shipment" />
    <preference for="Polkurier\Shipping\Api\Data\ShipmentSearchResultsInterface" type="Polkurier\Shipping\Model\SearchResults\ShipmentSearchResults" />
    <preference for="Polkurier\Shipping\Api\ShipmentRepositoryInterface" type="Polkurier\Shipping\Model\Repository\ShipmentRepository" />
    <preference for="Polkurier\Shipping\Api\Data\OrderPointInterface" type="Polkurier\Shipping\Model\OrderPoint" />
    <preference for="Polkurier\Shipping\Api\Data\ShipmentDraftInterface" type="Polkurier\Shipping\Model\Shipment\Draft" />
    <preference for="Polkurier\Shipping\Api\Data\ShipmentDraft\PackInterface" type="Polkurier\Shipping\Model\Shipment\Draft\Pack" />
    <preference for="Polkurier\Shipping\Api\ShipmentManagementInterface" type="Polkurier\Shipping\Model\Shipment\ShipmentManagement" />
    <preference for="Polkurier\Shipping\Api\SynchronizationInterface" type="Polkurier\Shipping\Model\Sync\Synchronization" />

    <!-- Checkout pricing -->
    <type name="Polkurier\Shipping\Model\Carrier\Polkurier">
        <arguments>
            <argument name="priceCalculator" xsi:type="object">Polkurier\Shipping\Model\Pricing\PriceCalculatorPool</argument>
            <argument name="logger" xsi:type="object">Polkurier\Shipping\Logger\Logger</argument>
            <!-- Only the admin's shipment pages use it; checkout never builds it -->
            <argument name="nativeLabel" xsi:type="object">Polkurier\Shipping\Model\Shipment\NativeLabel\Proxy</argument>
        </arguments>
    </type>
    <type name="Polkurier\Shipping\Model\Shipment\NativeLabel">
        <arguments>
            <argument name="logger" xsi:type="object">Polkurier\Shipping\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Polkurier\Shipping\Model\Pricing\PriceCalculatorPool">
        <arguments>
            <argument name="calculators" xsi:type="array">
                <item name="FIXED" xsi:type="object">Polkurier\Shipping\Model\Pricing\Fixed</item>
                <item name="TIER_SUBTOTAL" xsi:type="object">Polkurier\Shipping\Model\Pricing\SubtotalTiers</item>
                <item name="TIER_WEIGHT" xsi:type="object">Polkurier\Shipping\Model\Pricing\WeightTiers</item>
                <item name="TIER_SUBTOTAL_WEIGHT" xsi:type="object">Polkurier\Shipping\Model\Pricing\SubtotalWeightTiers</item>
            </argument>
        </arguments>
    </type>
    <virtualType name="Polkurier\Shipping\Model\Pricing\SubtotalTiers" type="Polkurier\Shipping\Model\Pricing\Tiers">
        <arguments>
            <argument name="bySubtotal" xsi:type="boolean">true</argument>
            <argument name="byWeight" xsi:type="boolean">false</argument>
        </arguments>
    </virtualType>
    <virtualType name="Polkurier\Shipping\Model\Pricing\WeightTiers" type="Polkurier\Shipping\Model\Pricing\Tiers">
        <arguments>
            <argument name="bySubtotal" xsi:type="boolean">false</argument>
            <argument name="byWeight" xsi:type="boolean">true</argument>
        </arguments>
    </virtualType>
    <virtualType name="Polkurier\Shipping\Model\Pricing\SubtotalWeightTiers" type="Polkurier\Shipping\Model\Pricing\Tiers">
        <arguments>
            <argument name="bySubtotal" xsi:type="boolean">true</argument>
            <argument name="byWeight" xsi:type="boolean">true</argument>
        </arguments>
    </virtualType>

    <!-- Synchronization with the Polkurier account -->
    <preference for="Polkurier\Shipping\Model\Sync\RemoteClockInterface" type="Polkurier\Shipping\Model\Sync\DetectedChangeClock" />
    <type name="Polkurier\Shipping\Model\Sync\Synchronization">
        <arguments>
            <argument name="adapters" xsi:type="array">
                <item name="address" xsi:type="object">Polkurier\Shipping\Model\Sync\Adapter\AddressAdapter</item>
                <item name="bank_account" xsi:type="object">Polkurier\Shipping\Model\Sync\Adapter\BankAccountAdapter</item>
                <item name="pack_template" xsi:type="object">Polkurier\Shipping\Model\Sync\Adapter\PackTemplateAdapter</item>
            </argument>
        </arguments>
    </type>
    <type name="Polkurier\Shipping\Model\Sync\SyncEngine">
        <arguments>
            <argument name="logger" xsi:type="object">Polkurier\Shipping\Logger\Logger</argument>
        </arguments>
    </type>

    <!-- The module logs to its own file -->
    <type name="Polkurier\Shipping\Model\ApiEventDispatcher">
        <arguments>
            <argument name="logger" xsi:type="object">Polkurier\Shipping\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Polkurier\Shipping\Model\Shipment\ShipmentManagement">
        <arguments>
            <argument name="logger" xsi:type="object">Polkurier\Shipping\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Polkurier\Shipping\Model\Shipment\AutoReconciler">
        <arguments>
            <argument name="logger" xsi:type="object">Polkurier\Shipping\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Polkurier\Shipping\Model\Shipment\StatusRefresher">
        <arguments>
            <argument name="logger" xsi:type="object">Polkurier\Shipping\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Polkurier\Shipping\Model\Checkout\MapConfigProvider">
        <arguments>
            <argument name="logger" xsi:type="object">Polkurier\Shipping\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Polkurier\Shipping\Model\Checkout\PointSelection">
        <arguments>
            <argument name="logger" xsi:type="object">Polkurier\Shipping\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Polkurier\Shipping\Model\Shipment\DefaultDraftBuilder">
        <arguments>
            <argument name="logger" xsi:type="object">Polkurier\Shipping\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Polkurier\Shipping\Cron\Synchronize">
        <arguments>
            <argument name="logger" xsi:type="object">Polkurier\Shipping\Logger\Logger</argument>
        </arguments>
    </type>

    <!-- Checkout: the pickup point travels with the shipping method, in every area -->
    <type name="Magento\Checkout\Api\ShippingInformationManagementInterface">
        <plugin name="polkurier_pickup_point" type="Polkurier\Shipping\Plugin\Checkout\ShippingInformationManagementPlugin" />
    </type>
    <type name="Magento\Sales\Api\OrderRepositoryInterface">
        <plugin name="polkurier_order_point" type="Polkurier\Shipping\Plugin\Sales\OrderRepositoryPlugin" />
    </type>
    <!-- Carrier logos next to the methods in checkout -->
    <type name="Magento\Quote\Model\Cart\ShippingMethodConverter">
        <plugin name="polkurier_method_logo" type="Polkurier\Shipping\Plugin\Quote\ShippingMethodLogoPlugin" />
    </type>

    <!-- Admin grids -->
    <type name="Polkurier\Shipping\Model\ResourceModel\Shipment\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">polkurier_shipment</argument>
            <argument name="resourceModel" xsi:type="string">Polkurier\Shipping\Model\ResourceModel\Shipment</argument>
        </arguments>
    </type>
    <virtualType name="Polkurier\Shipping\Model\ResourceModel\Address\Grid\Collection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">polkurier_address</argument>
            <argument name="resourceModel" xsi:type="string">Polkurier\Shipping\Model\ResourceModel\Address</argument>
        </arguments>
    </virtualType>
    <virtualType name="Polkurier\Shipping\Model\ResourceModel\BankAccount\Grid\Collection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">polkurier_bank_account</argument>
            <argument name="resourceModel" xsi:type="string">Polkurier\Shipping\Model\ResourceModel\BankAccount</argument>
        </arguments>
    </virtualType>
    <virtualType name="Polkurier\Shipping\Model\ResourceModel\PackTemplate\Grid\Collection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">polkurier_pack_template</argument>
            <argument name="resourceModel" xsi:type="string">Polkurier\Shipping\Model\ResourceModel\PackTemplate</argument>
        </arguments>
    </virtualType>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="polkurier_order_listing_data_source" xsi:type="string">Polkurier\Shipping\Model\ResourceModel\SalesOrder\Grid\Collection</item>
                <item name="polkurier_sales_shipment_listing_data_source" xsi:type="string">Polkurier\Shipping\Model\ResourceModel\SalesShipment\Grid\Collection</item>
                <item name="polkurier_shipment_listing_data_source" xsi:type="string">Polkurier\Shipping\Model\ResourceModel\Shipment\Grid\Collection</item>
                <item name="polkurier_order_shipment_listing_data_source" xsi:type="string">Polkurier\Shipping\Model\ResourceModel\Shipment\Grid\Collection</item>
                <item name="polkurier_address_listing_data_source" xsi:type="string">Polkurier\Shipping\Model\ResourceModel\Address\Grid\Collection</item>
                <item name="polkurier_bank_account_listing_data_source" xsi:type="string">Polkurier\Shipping\Model\ResourceModel\BankAccount\Grid\Collection</item>
                <item name="polkurier_pack_template_listing_data_source" xsi:type="string">Polkurier\Shipping\Model\ResourceModel\PackTemplate\Grid\Collection</item>
                <item name="polkurier_carrier_listing_data_source" xsi:type="string">Polkurier\Shipping\Model\ResourceModel\CarrierConfig\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
</config>
