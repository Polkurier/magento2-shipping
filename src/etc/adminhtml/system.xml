<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="carriers">
            <group id="polkurier" translate="label" type="text" sortOrder="1000" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Polkurier</label>
                <field id="api_availability" translate="label" type="label" sortOrder="1" showInDefault="1" showInWebsite="1">
                    <frontend_model>Polkurier\Shipping\Block\Adminhtml\System\Config\ApiAvailability</frontend_model>
                </field>
                <field id="active" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="sandbox_mode" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1">
                    <label>Sandbox mode</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Contact api@polkurier.pl to receive access to sandbox instance of the service</comment>
                </field>
                <field id="customer_id" translate="label" type="obscure" sortOrder="20" showInDefault="1" showInWebsite="1">
                    <label>Customer ID</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="api_token" translate="label" type="obscure" sortOrder="30" showInDefault="1" showInWebsite="1">
                    <label>Api token</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="available_carriers" translate="label" type="multiselect" sortOrder="40" showInDefault="1" showInWebsite="1">
                    <label>Available carriers</label>
                    <source_model>Polkurier\Shipping\Model\Config\Source\AvailableCarriers</source_model>
                    <backend_model>Polkurier\Shipping\Model\Config\Backend\AvailableCarriers</backend_model>
                    <can_be_empty>1</can_be_empty>
                </field>
<!--                <field id="carrier_config" translate="label" sortOrder="60" showInDefault="1" showInWebsite="1">-->
<!--                    <label>Carriers config</label>-->
<!--                    <frontend_model>Polkurier\Shipping\Block\Adminhtml\System\Config\Form\Field\UiComponentRenderer</frontend_model>-->
<!--&lt;!&ndash;                    <frontend_model>Polkurier\Shipping\Block\Adminhtml\System\Config\Form\Field\CarrierConfig</frontend_model>&ndash;&gt;-->
<!--                    <backend_model>Magento\Config\Model\Config\Backend\Serialized\ArraySerialized</backend_model>-->
<!--&lt;!&ndash;                    <backend_model>Polkurier\Shipping\Model\Config\Backend\ArraySerializedWithFiles</backend_model>&ndash;&gt;-->
<!--                </field>-->
            </group>
        </section>
    </system>
</config>
