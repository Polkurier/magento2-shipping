<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">
                polkurier_carrier_config_listing.polkurier_carrier_config_listing_data_source
            </item>
        </item>
    </argument>
    <settings>
        <spinner>polkurier_carrier_config_columns</spinner>
        <deps>
            <dep>polkurier_carrier_config_listing.polkurier_carrier_config_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="polkurier_carrier_config_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Polkurier_Shipping::carriers</aclResource>
        <dataProvider name="polkurier_carrier_config_listing_data_source"
                      class="Polkurier\Shipping\Ui\Component\Listing\CarrierConfig\DataProvider">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>config_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <columns name="polkurier_carrier_config_columns" class="Magento\Ui\Component\Listing\Columns">
        <settings>
            <editorConfig>
                <param name="clientConfig" xsi:type="array">
                    <item name="saveUrl" xsi:type="url" path="*/*/inlineEdit" />
                    <item name="validateBeforeSave" xsi:type="boolean">false</item>
                </param>
                <param name="indexField" xsi:type="string">config_id</param>
                <param name="enabled" xsi:type="boolean">true</param>
                <param name="selectProvider" xsi:type="string">
                    polkurier_carrier_config_listing.polkurier_carrier_config_listing.polkurier_carrier_config_columns.config_id
                </param>
            </editorConfig>
            <childDefaults>
                <param name="fieldAction" xsi:type="array">
                    <item name="provider" xsi:type="string">
                        polkurier_carrier_config_listing.polkurier_carrier_config_listing.polkurier_carrier_config_columns_editor
                    </item>
                    <item name="target" xsi:type="string">startEdit</item>
                    <item name="params" xsi:type="array">
                        <item name="0" xsi:type="string">${ $.$data.rowIndex }</item>
                        <item name="1" xsi:type="boolean">true</item>
                    </item>
                </param>
            </childDefaults>
        </settings>
        <selectionsColumn name="config_id">
            <settings>
                <indexField>config_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="sort_order" sortOrder="10">
            <settings>
                <label translate="true">Sort order</label>
                <filter>text</filter>
                <sortable>false</sortable>
                <editor>
                    <editorType>text</editorType>
                    <validation>
                        <rule name="validate-number" xsi:type="boolean">true</rule>
                    </validation>
                </editor>
            </settings>
        </column>
        <column name="carrier_name" sortOrder="20">
            <settings>
                <label translate="true">Carrier name</label>
                <filter>text</filter>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="custom_label" sortOrder="30">
            <settings>
                <label translate="true">Custom label</label>
                <filter>text</filter>
                <sortable>false</sortable>
                <editor>
                    <editorType>text</editorType>
                </editor>
            </settings>
        </column>
        <column name="image"
                class="Polkurier\Shipping\Ui\Component\Listing\CarrierConfig\Column\Thumbnail"
                component="Magento_Ui/js/grid/columns/thumbnail"
                sortOrder="40">
            <settings>
                <label translate="true">Image</label>
                <sortable>false</sortable>
                <editor>
                    <editorType>imageUploader</editorType>
                </editor>
            </settings>
        </column>
        <column name="pricing_model" component="Magento_Ui/js/grid/columns/select" sortOrder="50">
            <settings>
                <label translate="true">Pricing model</label>
                <filter>select</filter>
                <dataType>select</dataType>
                <options class="Polkurier\Shipping\Model\Config\Source\PricingModel" />
                <editor>
                    <editorType>select</editorType>
                </editor>
            </settings>
        </column>
        <column name="price" sortOrder="60">
            <settings>
                <label translate="true">Price</label>
                <filter>text</filter>
                <sortable>false</sortable>
                <editor>
                    <editorType>text</editorType>
                    <validation>
                        <rule name="validate-number" xsi:type="boolean">true</rule>
                        <rule name="validate-zero-or-greater" xsi:type="boolean">true</rule>
                    </validation>
                </editor>
            </settings>
        </column>
        <column name="active" component="Magento_Ui/js/grid/columns/select" sortOrder="70">
            <settings>
                <label translate="true">Active</label>
                <filter>select</filter>
                <dataType>select</dataType>
                <sortable>false</sortable>
                <options class="Magento\Config\Model\Config\Source\Yesno" />
                <editor>
                    <editorType>select</editorType>
                </editor>
            </settings>
        </column>
    </columns>
</listing>
