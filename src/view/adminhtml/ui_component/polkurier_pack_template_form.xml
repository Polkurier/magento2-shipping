<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">
                polkurier_pack_template_form.polkurier_pack_template_form_data_source
            </item>
        </item>
        <item name="config" xsi:type="array">
            <item name="deleteConfirmationMessage" translate="true" xsi:type="string">
                Are you sure you want to delete this template?
            </item>
        </item>
        <item name="label" xsi:type="string" translate="true">Update pack template</item>
        <item name="reverseMetadataMerge" xsi:type="boolean">true</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Polkurier\Shipping\Block\Adminhtml\Edit\BackButton" />
            <button name="delete" class="Polkurier\Shipping\Block\Adminhtml\Edit\DeleteButton" />
            <button name="save" class="Polkurier\Shipping\Block\Adminhtml\Edit\SaveButton" />
            <button name="save_and_continue" class="Polkurier\Shipping\Block\Adminhtml\Edit\SaveAndContinueButton" />
        </buttons>
        <namespace>polkurier_pack_template_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>polkurier_pack_template_form.polkurier_pack_template_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="polkurier_pack_template_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="*/*/save" />
<!--            <validateUrl path="*/*/validate" />-->
        </settings>
        <aclResource>Polkurier_Shipping::addresses</aclResource>
        <dataProvider class="Polkurier\Shipping\Ui\Component\Form\PackTemplate\DataProviderVirtual"
                      name="polkurier_pack_template_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>template_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <container name="messages" component="Magento_Ui/js/form/components/html">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="additionalClasses" xsi:type="string">message message-error</item>
                <item name="visible" xsi:type="boolean">false</item>
                <item name="imports" xsi:type="array">
                    <item name="responseData" xsi:type="string">${ $.parentName }:responseData</item>
                </item>
                <item name="listens" xsi:type="array">
                    <item name="responseData.error" xsi:type="string">visible</item>
                    <item name="responseData.messages" xsi:type="string">content</item>
                </item>
            </item>
        </argument>
    </container>
    <fieldset name="general" sortOrder="10">
        <settings>
            <label translate="true">General</label>
            <collapsible>false</collapsible>
        </settings>
        <field name="template_id" formElement="hidden">
            <settings>
                <dataType>text</dataType>
                <dataScope>template_id</dataScope>
            </settings>
        </field>
        <field name="name" formElement="input" sortOrder="10">
            <settings>
                <label translate="true">Label</label>
                <dataType>text</dataType>
                <dataScope>name</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="description" formElement="textarea" sortOrder="20">
            <settings>
                <label translate="true">Description</label>
                <dataType>text</dataType>
                <dataScope>description</dataScope>
            </settings>
        </field>
        <field name="default" formElement="select" sortOrder="30">
            <settings>
                <label translate="true">Default</label>
                <dataType>boolean</dataType>
                <dataScope>default</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Magento\Config\Model\Config\Source\Yesno" />
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="type" formElement="select" sortOrder="40">
            <settings>
                <label translate="true">Type</label>
                <dataType>text</dataType>
                <dataScope>type</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Polkurier\Shipping\Model\Config\Source\PackType" />
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="shipment_type" formElement="select" sortOrder="50">
            <settings>
                <label translate="true">Shipment type</label>
                <dataType>text</dataType>
                <dataScope>shipment_type</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Polkurier\Shipping\Model\Config\Source\ShipmentType" />
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="carrier_code" formElement="select" sortOrder="60">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="caption" xsi:type="string" translate="true">Select carrier...</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Carrier</label>
                <dataType>text</dataType>
                <dataScope>carrier_code</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Polkurier\Shipping\Model\Config\Source\AvailableCarriers" />
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>
    <fieldset name="measurements" sortOrder="20">
        <settings>
            <label translate="true">Measurements</label>
            <collapsible>false</collapsible>
        </settings>
        <field name="length" formElement="input" sortOrder="10">
            <settings>
                <label translate="true">Length [cm]</label>
                <dataType>text</dataType>
                <dataScope>length</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="validate-number" xsi:type="boolean">true</rule>
                    <rule name="validate-zero-or-greater" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="height" formElement="input" sortOrder="20">
            <settings>
                <label translate="true">Height [cm]</label>
                <dataType>text</dataType>
                <dataScope>height</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="validate-number" xsi:type="boolean">true</rule>
                    <rule name="validate-zero-or-greater" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="width" formElement="input" sortOrder="30">
            <settings>
                <label translate="true">Width [cm]</label>
                <dataType>text</dataType>
                <dataScope>width</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="validate-number" xsi:type="boolean">true</rule>
                    <rule name="validate-zero-or-greater" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="weight" formElement="input" sortOrder="40">
            <settings>
                <label translate="true">Weight [kg]</label>
                <dataType>text</dataType>
                <dataScope>weight</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="validate-number" xsi:type="boolean">true</rule>
                    <rule name="validate-zero-or-greater" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
    </fieldset>
    <fieldset name="additional_services" sortOrder="30">
        <settings>
            <label translate="true">Additional services</label>
            <collapsible>false</collapsible>
        </settings>
        <field name="cod" formElement="input" sortOrder="10">
            <settings>
                <label translate="true">Cash on delivery amount</label>
                <dataType>text</dataType>
                <dataScope>cod</dataScope>
                <validation>
                    <rule name="validate-number" xsi:type="boolean">true</rule>
                    <rule name="validate-zero-or-greater" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="insurance" formElement="input" sortOrder="20">
            <settings>
                <label translate="true">Insurance amount</label>
                <dataType>text</dataType>
                <dataScope>insurance</dataScope>
                <validation>
                    <rule name="validate-number" xsi:type="boolean">true</rule>
                    <rule name="validate-zero-or-greater" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="services" formElement="multiselect" sortOrder="30">
            <settings>
                <label translate="true">Additional services</label>
                <dataType>text</dataType>
                <dataScope>services</dataScope>
            </settings>
            <formElements>
                <multiselect>
                    <settings>
                        <options class="Polkurier\Shipping\Model\Config\Source\AdditionalService" />
                    </settings>
                </multiselect>
            </formElements>
        </field>
    </fieldset>
</form>
