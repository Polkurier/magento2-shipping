<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Api/etc/extension_attributes.xsd">
    <extension_attributes for="Magento\Checkout\Api\Data\ShippingInformationInterface">
        <attribute code="polkurier_point_id" type="string" />
        <attribute code="polkurier_point_cod" type="bool" />
    </extension_attributes>
    <extension_attributes for="Magento\Quote\Api\Data\CartInterface">
        <attribute code="polkurier_shipment_data" type="Polkurier\Shipping\Api\Data\Quote\ShipmentDataInterface" />
    </extension_attributes>
    <extension_attributes for="Magento\Sales\Api\Data\ShipmentInterface">
        <attribute code="polkurier_shipment_data" type="Polkurier\Shipping\Api\Data\OrderInterface" />
    </extension_attributes>
</config>
