<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="carriers">
            <group id="polkurier" translate="label" sortOrder="1000" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Polkurier</label>
                <field id="active" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" canRestore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="title" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Title</label>
                    <comment>Admin only: customers see just each delivery method's label, never this title.</comment>
                </field>
                <field id="sallowspecific" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" canRestore="1">
                    <label>Ship to Applicable Countries</label>
                    <frontend_class>shipping-applicable-country</frontend_class>
                    <source_model>Magento\Shipping\Model\Config\Source\Allspecificcountries</source_model>
                </field>
                <field id="specificcountry" translate="label" type="multiselect" sortOrder="31" showInDefault="1" showInWebsite="1">
                    <label>Ship to Specific Countries</label>
                    <source_model>Magento\Directory\Model\Config\Source\Country</source_model>
                    <can_be_empty>1</can_be_empty>
                </field>
                <field id="showmethod" translate="label" type="select" sortOrder="32" showInDefault="1" showInWebsite="1" canRestore="1">
                    <label>Show Method if Not Applicable</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="specificerrmsg" translate="label" type="textarea" sortOrder="33" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Displayed Error Message</label>
                </field>
                <field id="sort_order" translate="label" type="text" sortOrder="34" showInDefault="1" showInWebsite="1" canRestore="1">
                    <label>Sort Order</label>
                    <validate>validate-number</validate>
                </field>

                <group id="general" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1">
                    <label>Polkurier account</label>
                    <comment>Credentials are set per website; each website may use its own Polkurier account.</comment>
                    <field id="customer_id" translate="label" type="obscure" sortOrder="10" showInDefault="1" showInWebsite="1">
                        <label>Customer ID</label>
                        <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    </field>
                    <field id="api_token" translate="label" type="obscure" sortOrder="20" showInDefault="1" showInWebsite="1">
                        <label>API token</label>
                        <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    </field>
                    <field id="sandbox_mode" translate="label comment" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" canRestore="1">
                        <label>Sandbox</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <comment>Sends requests to the Polkurier sandbox. Contact api@polkurier.pl for sandbox access.</comment>
                    </field>
                    <field id="test_connection" translate="button_label" sortOrder="40" showInDefault="1" showInWebsite="1">
                        <button_label>Test connection</button_label>
                        <frontend_model>Polkurier\Shipping\Block\Adminhtml\System\Config\TestConnection</frontend_model>
                    </field>
                    <field id="timeout" translate="label" type="text" sortOrder="50" showInDefault="1" canRestore="1">
                        <label>Request timeout (seconds)</label>
                        <validate>validate-digits validate-greater-than-zero</validate>
                    </field>
                    <field id="logging" translate="label comment" type="select" sortOrder="60" showInDefault="1" showInWebsite="1" canRestore="1">
                        <label>Log errors</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <comment>To var/log/polkurier.log, with the API token masked.</comment>
                    </field>
                    <field id="log_methods" translate="label comment" type="multiselect" sortOrder="70" showInDefault="1" showInWebsite="1" canRestore="1">
                        <label>Log all traffic of</label>
                        <source_model>Polkurier\Shipping\Model\Config\Source\ApiMethod</source_model>
                        <can_be_empty>1</can_be_empty>
                        <comment>Successful requests and answers of these API methods are logged too.</comment>
                        <depends>
                            <field id="logging">1</field>
                        </depends>
                    </field>
                </group>

                <group id="shipments" translate="label" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Shipments</label>
                    <field id="available_carriers" translate="label comment" type="multiselect" sortOrder="5" showInDefault="1" showInWebsite="1">
                        <label>Available carriers</label>
                        <source_model>Polkurier\Shipping\Model\Config\Source\AccountCarrier</source_model>
                        <can_be_empty>1</can_be_empty>
                        <comment>The carriers you work with. Only these appear under Polkurier > Settings > Carriers, in checkout and when shipping; the others keep their settings but stay out of sight. Nothing selected: all of the account's carriers. The list comes from the Polkurier account.</comment>
                    </field>
                    <field id="default_carrier" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1">
                        <label>Default carrier</label>
                        <source_model>Polkurier\Shipping\Model\Config\Source\Carrier</source_model>
                        <comment>Preselected for orders placed with another shipping method. The list comes from the Polkurier account.</comment>
                    </field>
                    <field id="default_shipment_type" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" canRestore="1">
                        <label>Default shipment type</label>
                        <source_model>Polkurier\Shipping\Model\Config\Source\ShipmentType</source_model>
                    </field>
                    <field id="use_store_information_address" translate="label comment" type="select" sortOrder="25" showInDefault="1" showInWebsite="1" canRestore="1">
                        <label>Fall back to the store's address</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <comment>When no default sender is set in Polkurier > Settings > Addresses, send from the address in General > Store Information. Comes before the shipping origin.</comment>
                    </field>
                    <field id="use_store_origin_address" translate="label comment" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" canRestore="1">
                        <label>Fall back to the shipping origin</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <comment>When no default sender is set in Polkurier > Settings > Addresses, send from the address in Sales > Shipping Settings > Origin.</comment>
                    </field>
                    <field id="default_sender_email" translate="label" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" canRestore="1">
                        <label>Sender e-mail with the store's addresses</label>
                        <source_model>Magento\Config\Model\Config\Source\Email\Identity</source_model>
                    </field>
                    <field id="default_additional_services" translate="label comment" type="multiselect" sortOrder="50" showInDefault="1" showInWebsite="1" canRestore="1">
                        <label>Additional services selected by default</label>
                        <source_model>Polkurier\Shipping\Model\Config\Source\AdditionalService</source_model>
                        <can_be_empty>1</can_be_empty>
                        <comment>Only those the chosen carrier sells are preselected.</comment>
                    </field>
                    <field id="insure_by_default" translate="label comment" type="select" sortOrder="60" showInDefault="1" showInWebsite="1" canRestore="1">
                        <label>Insure for the order total by default</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <comment>Carriers that require insurance with cash on delivery are always insured then.</comment>
                    </field>
                    <field id="cod_payment_methods" translate="label comment" type="multiselect" sortOrder="70" showInDefault="1" showInWebsite="1" canRestore="1">
                        <label>Cash on delivery payment methods</label>
                        <source_model>Magento\Payment\Model\Config\Source\Allmethods</source_model>
                        <can_be_empty>1</can_be_empty>
                        <comment>Orders paid with these are shipped with cash on delivery for the order total; they are hidden in checkout when the carrier or the pickup point cannot collect.</comment>
                    </field>
                    <field id="default_cod_type" translate="label" type="select" sortOrder="80" showInDefault="1" showInWebsite="1" canRestore="1">
                        <label>Cash on delivery payout time</label>
                        <source_model>Polkurier\Shipping\Model\Config\Source\CodType</source_model>
                    </field>
                    <field id="default_cod_refund_type" translate="label" type="select" sortOrder="90" showInDefault="1" showInWebsite="1" canRestore="1">
                        <label>Cash on delivery paid out to</label>
                        <source_model>Polkurier\Shipping\Model\Config\Source\CodReturnType</source_model>
                    </field>
                    <field id="description_format" translate="label comment" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Shipment description</label>
                        <comment>%s is replaced with the order number. Polkurier keeps up to 30 characters.</comment>
                    </field>
                    <field id="label_format" translate="label" type="select" sortOrder="110" showInDefault="1" showInWebsite="1" canRestore="1">
                        <label>Label format</label>
                        <source_model>Polkurier\Shipping\Model\Config\Source\LabelFormat</source_model>
                    </field>
                    <field id="notify_customer" translate="label" type="select" sortOrder="120" showInDefault="1" showInWebsite="1" canRestore="1">
                        <label>Send the shipment e-mail to the customer</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    </field>
                    <field id="native_labels" translate="label comment" type="select" sortOrder="130" showInDefault="1" showInWebsite="1" canRestore="1">
                        <label>Shipping labels on Magento's shipment page</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <comment>For orders placed with these shipping methods, "Create Shipping Label" on Magento's New Shipment page places the order and stores its label with the shipment.</comment>
                    </field>
                    <field id="shipment_screen" translate="label comment" type="select" sortOrder="140" showInDefault="1" showInWebsite="1" canRestore="1">
                        <label>Polkurier shipment screen</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <comment>Adds a "Ship with Polkurier" button to the order page, for any order.</comment>
                    </field>
                </group>

                <group id="map" translate="label" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Pickup point map</label>
                    <field id="default_latitude" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Initial latitude</label>
                        <validate>validate-number</validate>
                    </field>
                    <field id="default_longitude" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Initial longitude</label>
                        <validate>validate-number</validate>
                    </field>
                    <field id="default_zoom" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Initial zoom</label>
                        <validate>validate-digits</validate>
                    </field>
                    <field id="show_list" translate="label" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Show the list of points</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    </field>
                    <field id="show_search_input" translate="label" type="select" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Show the search field</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    </field>
                    <field id="required_point_functions" translate="label comment" type="multiselect" sortOrder="60" showInDefault="1" showInWebsite="1" canRestore="1">
                        <label>Show only points that</label>
                        <source_model>Polkurier\Shipping\Model\Config\Source\PointFunction</source_model>
                        <can_be_empty>1</can_be_empty>
                    </field>
                </group>

                <group id="sync" translate="label" sortOrder="40" showInDefault="1">
                    <label>Synchronization</label>
                    <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" canRestore="1">
                        <label>Synchronize addresses, bank accounts and pack templates hourly</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <comment>Changes made in Magento are also sent as soon as they are saved.</comment>
                    </field>
                    <field id="status_enabled" translate="label" type="select" sortOrder="20" showInDefault="1" canRestore="1">
                        <label>Update shipment statuses every 30 minutes</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    </field>
                </group>
            </group>
        </section>
    </system>
</config>
