<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="head.additional">
            <block class="Polkurier\Shipping\Block\Checkout\Map\Head" name="polkurier_shipping.map.head"
                   template="Polkurier_Shipping::checkout/map/head.phtml" />
        </referenceBlock>
        <referenceBlock name="checkout.root">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="checkout" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="steps" xsi:type="array">
                                    <item name="children" xsi:type="array">
                                        <item name="shipping-step" xsi:type="array">
                                            <item name="children" xsi:type="array">
                                                <item name="shippingAddress" xsi:type="array">
                                                    <item name="config" xsi:type="array">
                                                        <item name="shippingMethodListTemplate" xsi:type="string">Polkurier_Shipping/shipping-address/shipping-method-list</item>
                                                        <item name="shippingMethodItemTemplate" xsi:type="string">Polkurier_Shipping/shipping-address/shipping-method-item</item>
                                                    </item>
                                                    <item name="children" xsi:type="array">
                                                        <item name="polkurier-map-component" xsi:type="array">
                                                            <item name="component" xsi:type="string">Polkurier_Shipping/js/view/checkout/map</item>
                                                            <item name="displayArea" xsi:type="string">polkurier-map-button</item>
                                                            <item name="config" xsi:type="array">
                                                                <item name="template" xsi:type="string">Polkurier_Shipping/shipping-address/shipping-method-item/button</item>
                                                            </item>
                                                        </item>
                                                    </item>
                                                </item>
                                            </item>
                                        </item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
