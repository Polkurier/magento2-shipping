<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_model_service_quote_submit_before">
        <observer name="polkurier_validate_pickup_point" instance="Polkurier\Shipping\Observer\ValidatePickupPoint" />
    </event>
    <event name="sales_model_service_quote_submit_success">
        <observer name="polkurier_copy_pickup_point" instance="Polkurier\Shipping\Observer\CopyPickupPointToOrder" />
    </event>
    <event name="payment_method_is_active">
        <observer name="polkurier_restrict_cash_on_delivery" instance="Polkurier\Shipping\Observer\RestrictCashOnDelivery" />
    </event>
</config>
