<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">
                polkurier_address_listing.polkurier_address_listing_data_source
            </item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add new address</label>
            </button>
        </buttons>
        <spinner>polkurier_address_columns</spinner>
        <deps>
            <dep>polkurier_address_listing.polkurier_address_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="polkurier_address_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <updateUrl path="mui/index/render" />
            <storageConfig>
                <param name="indexField" xsi:type="string">address_id</param>
            </storageConfig>
        </settings>
        <aclResource>Polkurier_Shipping::addresses</aclResource>
        <dataProvider name="polkurier_address_listing_data_source"
                      class="Polkurier\Shipping\Ui\Component\Listing\DataProvider">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>address_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <columnsControls name="columns_controls" />
        <filterSearch name="fulltext" />
        <filters name="listing_filters" component="Magento_Ui/js/grid/filters/filters">
            <settings>
                <storageConfig>
                    <param name="provider" xsi:type="string">
                        polkurier_address_listing.polkurier_address_listing.listing_top.bookmarks
                    </param>
                    <param name="namespace" xsi:type="string">current.filters</param>
                </storageConfig>
                <childDefaults>
                    <param name="provider" xsi:type="string">
                        polkurier_address_listing.polkurier_address_listing.listing_top.listing_filters
                    </param>
                    <param name="imports" xsi:type="array">
                        <item name="visible" xsi:type="string">
                            polkurier_address_listing.polkurier_address_listing.listing_top.bookmarks:current.columns.${ $.index }.visible
                        </item>
                    </param>
                </childDefaults>
            </settings>
        </filters>
        <massaction name="listing_massaction" component="Magento_Ui/js/grid/massactions">
            <action name="delete">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="isAjax" xsi:type="boolean">true</item>
<!--                        <item name="selectProvider" xsi:type="string">polkurier_address_listing.polkurier_address_listing.polkurier_address_columns.address_id</item>-->
                    </item>
                </argument>
                <settings>
                    <url path="*/*/massDelete" />
                    <type>delete</type>
                    <label translate="true">Delete</label>
                    <confirm>
                        <title translate="true">Delete items</title>
                        <message translate="true">Are you sure you want to delete selected addresses?</message>
                    </confirm>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="polkurier_address_columns" class="Magento\Ui\Component\Listing\Columns">
        <settings>
            <editorConfig>
                <param name="clientConfig" xsi:type="array">
                    <item name="saveUrl" xsi:type="url" path="*/*/inlineEdit" />
                    <item name="validateBeforeSave" xsi:type="boolean">false</item>
                </param>
                <param name="indexField" xsi:type="string">address_id</param>
                <param name="enabled" xsi:type="boolean">true</param>
                <param name="selectProvider" xsi:type="string">
                    polkurier_address_listing.polkurier_address_listing.polkurier_address_columns.ids
                </param>
            </editorConfig>
            <childDefaults>
                <param name="fieldAction" xsi:type="array">
                    <item name="provider" xsi:type="string">
                        polkurier_address_listing.polkurier_address_listing.polkurier_address_columns_editor
                    </item>
                    <item name="target" xsi:type="string">startEdit</item>
                    <item name="params" xsi:type="array">
                        <item name="0" xsi:type="string">${ $.$data.rowIndex }</item>
                        <item name="1" xsi:type="boolean">true</item>
                    </item>
                </param>
            </childDefaults>
        </settings>
        <selectionsColumn name="ids">
            <settings>
                <indexField>address_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="name" sortOrder="10">
            <settings>
                <label translate="true">Label</label>
                <filter>text</filter>
                <editor>
                    <editorType>text</editorType>
                    <validation>
                        <rule name="required-entry" xsi:type="boolean">true</rule>
                    </validation>
                </editor>
            </settings>
        </column>
        <column name="person" sortOrder="20">
            <settings>
                <label translate="true">Name</label>
                <filter>text</filter>
                <editor>
                    <editorType>text</editorType>
                    <validation>
                        <rule name="required-entry" xsi:type="boolean">true</rule>
                    </validation>
                </editor>
            </settings>
        </column>
        <column name="company" sortOrder="30">
            <settings>
                <label translate="true">Company</label>
                <filter>text</filter>
                <editor>
                    <editorType>text</editorType>
                </editor>
            </settings>
        </column>
        <column name="street" sortOrder="40">
            <settings>
                <label translate="true">Street</label>
                <filter>text</filter>
                <editor>
                    <editorType>text</editorType>
                    <validation>
                        <rule name="required-entry" xsi:type="boolean">true</rule>
                    </validation>
                </editor>
            </settings>
        </column>
        <column name="house_number" sortOrder="50">
            <settings>
                <label translate="true">House number</label>
                <filter>text</filter>
                <editor>
                    <editorType>text</editorType>
                    <validation>
                        <rule name="required-entry" xsi:type="boolean">true</rule>
                    </validation>
                </editor>
            </settings>
        </column>
        <column name="flat_number" sortOrder="60">
            <settings>
                <label translate="true">Flat number</label>
                <filter>text</filter>
                <editor>
                    <editorType>text</editorType>
                </editor>
            </settings>
        </column>
        <column name="postcode" sortOrder="70">
            <settings>
                <label translate="true">Postcode</label>
                <filter>text</filter>
                <editor>
                    <editorType>text</editorType>
                    <validation>
                        <rule name="required-entry" xsi:type="boolean">true</rule>
                    </validation>
                </editor>
            </settings>
        </column>
        <column name="city" sortOrder="80">
            <settings>
                <label translate="true">City</label>
                <filter>text</filter>
                <editor>
                    <editorType>text</editorType>
                    <validation>
                        <rule name="required-entry" xsi:type="boolean">true</rule>
                    </validation>
                </editor>
            </settings>
        </column>
        <column name="province" sortOrder="90">
            <settings>
                <label translate="true">Province</label>
                <filter>text</filter>
                <editor>
                    <editorType>text</editorType>
                </editor>
            </settings>
        </column>
        <column name="country" component="Magento_Ui/js/grid/columns/select" sortOrder="100">
            <settings>
                <label translate="true">Country</label>
                <filter>select</filter>
                <dataType>select</dataType>
                <options class="Magento\Directory\Model\Config\Source\Country" />
                <editor>
                    <editorType>select</editorType>
                    <validation>
                        <rule name="required-entry" xsi:type="boolean">true</rule>
                    </validation>
                </editor>
            </settings>
        </column>
        <column name="phone" sortOrder="110">
            <settings>
                <label translate="true">Phone</label>
                <filter>text</filter>
                <editor>
                    <editorType>text</editorType>
                    <validation>
                        <rule name="required-entry" xsi:type="boolean">true</rule>
                    </validation>
                </editor>
            </settings>
        </column>
        <column name="email" sortOrder="120">
            <settings>
                <label translate="true">Email</label>
                <filter>text</filter>
                <editor>
                    <editorType>text</editorType>
                    <validation>
                        <rule name="required-entry" xsi:type="boolean">true</rule>
                        <rule name="validate-email" xsi:type="boolean">true</rule>
                    </validation>
                </editor>
            </settings>
        </column>
        <column name="cover" component="Magento_Ui/js/grid/columns/select" sortOrder="130">
            <settings>
                <label translate="true">Cover</label>
                <filter>select</filter>
                <dataType>select</dataType>
                <options class="Magento\Config\Model\Config\Source\Yesno" />
                <editor>
                    <editorType>select</editorType>
                </editor>
            </settings>
        </column>
        <column name="default" component="Magento_Ui/js/grid/columns/select" sortOrder="140">
            <settings>
                <label translate="true">Default</label>
                <filter>select</filter>
                <dataType>select</dataType>
                <options class="Magento\Config\Model\Config\Source\Yesno" />
                <editor>
                    <editorType>select</editorType>
                </editor>
            </settings>
        </column>
        <actionsColumn name="actions" class="Polkurier\Shipping\Ui\Component\Listing\Address\Column\Actions">
            <settings>
                <indexField>address_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
