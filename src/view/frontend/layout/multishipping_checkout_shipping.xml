<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Polkurier_Shipping::css/pickup-point.css"/>
    </head>
    <body>
        <referenceBlock name="checkout_shipping">
            <!-- Rendered per address by Plugin\Multishipping\ShippingStepPlugin -->
            <block class="Polkurier\Shipping\Block\Multishipping\PickupPoint" name="checkout_shipping.pickup_point" as="pickup_point"/>
        </referenceBlock>
        <referenceContainer name="content">
            <block class="Polkurier\Shipping\Block\Multishipping\MethodLogos" name="polkurier.method_logos" after="-"/>
        </referenceContainer>
    </body>
</page>
