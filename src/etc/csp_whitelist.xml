<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <!-- The pickup point map widget, its tiles and the pictures it shows -->
    <policies>
        <policy id="script-src">
            <values>
                <value id="polkurier_maps" type="host">maps.polkurier.pl</value>
                <value id="polkurier_maps_sandbox" type="host">maps-sandbox.polkurier.pl</value>
            </values>
        </policy>
        <policy id="style-src">
            <values>
                <value id="polkurier_maps" type="host">maps.polkurier.pl</value>
                <value id="polkurier_maps_sandbox" type="host">maps-sandbox.polkurier.pl</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                <value id="polkurier_maps" type="host">maps.polkurier.pl</value>
                <value id="polkurier_maps_sandbox" type="host">maps-sandbox.polkurier.pl</value>
            </values>
        </policy>
        <policy id="img-src">
            <values>
                <value id="polkurier_www" type="host">www.polkurier.pl</value>
                <value id="polkurier_maps" type="host">maps.polkurier.pl</value>
                <value id="polkurier_maps_sandbox" type="host">maps-sandbox.polkurier.pl</value>
                <value id="openstreetmap_tiles" type="host">*.tile.openstreetmap.org</value>
                <value id="openstreetmap_tile" type="host">tile.openstreetmap.org</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
