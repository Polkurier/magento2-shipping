<!-- The order page's Polkurier tab: every Polkurier shipment of the order, also those that weren't
     placed, with why, and what can be done with each; the toolbar and mass actions of the
     shipments grid, kept to the order -->
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">polkurier_order_view_shipment_listing.polkurier_order_view_shipment_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>polkurier_order_view_shipment_columns</spinner>
        <deps>
            <dep>polkurier_order_view_shipment_listing.polkurier_order_view_shipment_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="polkurier_order_view_shipment_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">entity_id</param>
            </storageConfig>
            <filterUrlParams>
                <param name="order_id">*</param>
            </filterUrlParams>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Polkurier_Shipping::shipments</aclResource>
        <dataProvider class="Polkurier\Shipping\Ui\Component\DataProvider\GridDataProvider" name="polkurier_order_view_shipment_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <exportButton name="export_button">
            <settings>
                <additionalParams>
                    <param xsi:type="string" active="true" name="order_id">*</param>
                </additionalParams>
            </settings>
        </exportButton>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters"/>
        <!-- As on the shipments grid; each takes this order's shipments only -->
        <massaction name="listing_massaction">
            <action name="label" class="Polkurier\Shipping\Ui\Component\MassAction\OrderScopedAction">
                <settings>
                    <url path="polkurier/shipment/label"/>
                    <type>label</type>
                    <label translate="true">Print labels</label>
                </settings>
            </action>
            <action name="protocol" class="Polkurier\Shipping\Ui\Component\MassAction\OrderScopedAction">
                <settings>
                    <url path="polkurier/shipment/protocol"/>
                    <type>protocol</type>
                    <label translate="true">Print handover protocol</label>
                </settings>
            </action>
            <action name="refresh" class="Polkurier\Shipping\Ui\Component\MassAction\OrderScopedAction">
                <settings>
                    <url path="polkurier/shipment/massRefresh"/>
                    <type>refresh</type>
                    <label translate="true">Update statuses</label>
                </settings>
            </action>
            <action name="pickup" class="Polkurier\Shipping\Ui\Component\MassAction\OrderScopedAction">
                <argument name="aclResource" xsi:type="string">Polkurier_Shipping::shipment_create</argument>
                <settings>
                    <url path="polkurier/shipment/massPickup"/>
                    <type>pickup</type>
                    <label translate="true">Book a collective pickup</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="polkurier_order_view_shipment_columns">
        <selectionsColumn name="ids" sortOrder="0">
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="polkurier_number" sortOrder="10">
            <settings>
                <label translate="true">Polkurier order</label>
                <filter>text</filter>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="20">
            <settings>
                <label translate="true">Created</label>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="state" component="Magento_Ui/js/grid/columns/select" sortOrder="30">
            <settings>
                <label translate="true">State</label>
                <options class="Polkurier\Shipping\Model\Config\Source\ShipmentState"/>
                <filter>select</filter>
                <dataType>select</dataType>
            </settings>
        </column>
        <column name="carrier_code" component="Magento_Ui/js/grid/columns/select" sortOrder="40">
            <settings>
                <label translate="true">Carrier</label>
                <options class="Polkurier\Shipping\Model\Config\Source\CarrierName"/>
                <filter>select</filter>
                <dataType>select</dataType>
            </settings>
        </column>
        <column name="magento_shipment" class="Polkurier\Shipping\Ui\Component\Listing\Column\MagentoShipmentLinkColumn" sortOrder="50">
            <settings>
                <label translate="true">Magento shipment</label>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="waybills" class="Polkurier\Shipping\Ui\Component\Listing\Column\WaybillsColumn" sortOrder="60">
            <settings>
                <label translate="true">Waybills</label>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <filter>text</filter>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="status_label" sortOrder="70">
            <settings>
                <label translate="true">Delivery status</label>
                <filter>text</filter>
            </settings>
        </column>
        <column name="last_error" sortOrder="80">
            <settings>
                <label translate="true">Last error</label>
                <filter>text</filter>
                <sortable>false</sortable>
            </settings>
        </column>
        <actionsColumn name="actions" class="Polkurier\Shipping\Ui\Component\Listing\Column\ShipmentActionsColumn" sortOrder="90">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="onOrderPage" xsi:type="boolean">true</item>
                </item>
            </argument>
            <settings>
                <indexField>entity_id</indexField>
                <label translate="true">Actions</label>
            </settings>
        </actionsColumn>
    </columns>
</listing>
