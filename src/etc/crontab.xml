<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="polkurier">
        <!-- As often as the "Update shipment statuses" setting says -->
        <job name="polkurier_refresh_shipment_status" instance="Polkurier\Shipping\Cron\RefreshShipmentStatusTask"
             method="execute">
            <config_path>carriers/polkurier/sync/status_schedule</config_path>
        </job>
        <job name="polkurier_reconcile_shipments" instance="Polkurier\Shipping\Cron\ReconcileShipmentsTask"
             method="execute">
            <schedule>*/10 * * * *</schedule>
        </job>
        <job name="polkurier_synchronize" instance="Polkurier\Shipping\Cron\SynchronizeTask" method="execute">
            <schedule>15 * * * *</schedule>
        </job>
        <!-- The account's carriers change rarely -->
        <job name="polkurier_refresh_carriers" instance="Polkurier\Shipping\Cron\RefreshCarriersTask" method="execute">
            <schedule>45 3 * * *</schedule>
        </job>
    </group>
</config>
