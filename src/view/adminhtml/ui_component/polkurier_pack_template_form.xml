<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">polkurier_pack_template_form.polkurier_pack_template_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Pack template</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <namespace>polkurier_pack_template_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>polkurier_pack_template_form.polkurier_pack_template_form_data_source</dep>
        </deps>
        <buttons>
            <button name="back">
                <url path="*/*/index"/>
                <class>back</class>
                <label translate="true">Back</label>
            </button>
            <button name="delete" class="Polkurier\Shipping\Ui\Component\Form\PackTemplate\DeleteButtonVirtual"/>
            <button name="save_and_continue"
                    class="Polkurier\Shipping\Ui\Component\Form\PackTemplate\SaveAndContinueButtonVirtual"/>
            <button name="save" class="Polkurier\Shipping\Ui\Component\Control\SaveButton"/>
        </buttons>
    </settings>
    <dataSource name="polkurier_pack_template_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="*/*/save"/>
        </settings>
        <dataProvider class="Polkurier\Shipping\Ui\Component\Form\PackTemplate\DataProviderVirtual"
                      name="polkurier_pack_template_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label/>
        </settings>
        <field name="id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>id</dataScope>
            </settings>
        </field>
        <field name="name" formElement="input">
            <settings>
                <label translate="true">Template name</label>
                <dataType>text</dataType>
                <dataScope>name</dataScope>
                <validation><rule name="required-entry" xsi:type="boolean">true</rule></validation>
            </settings>
        </field>
        <field name="description" formElement="textarea">
            <settings>
                <label translate="true">Description</label>
                <dataType>text</dataType>
                <dataScope>description</dataScope>
            </settings>
        </field>
        <field name="pack_type" formElement="select">
            <settings>
                <label translate="true">Parcel type</label>
                <dataType>text</dataType>
                <dataScope>pack_type</dataScope>
                <validation><rule name="required-entry" xsi:type="boolean">true</rule></validation>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Polkurier\Shipping\Model\Config\Source\PackType"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="length" formElement="input">
            <settings>
                <label translate="true">Length (cm)</label>
                <dataType>text</dataType>
                <dataScope>length</dataScope>
                <validation>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                    <rule name="validate-greater-than-zero" xsi:type="boolean">true</rule>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="width" formElement="input">
            <settings>
                <label translate="true">Width (cm)</label>
                <dataType>text</dataType>
                <dataScope>width</dataScope>
                <validation>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                    <rule name="validate-greater-than-zero" xsi:type="boolean">true</rule>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="height" formElement="input">
            <settings>
                <label translate="true">Height (cm)</label>
                <dataType>text</dataType>
                <dataScope>height</dataScope>
                <validation>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                    <rule name="validate-greater-than-zero" xsi:type="boolean">true</rule>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="weight" formElement="input">
            <settings>
                <label translate="true">Maximum weight (kg)</label>
                <notice translate="true">The most a parcel of this template may weigh with what's in it.</notice>
                <dataType>text</dataType>
                <dataScope>weight</dataScope>
                <validation>
                    <rule name="validate-number" xsi:type="boolean">true</rule>
                    <rule name="validate-greater-than-zero" xsi:type="boolean">true</rule>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="tare" formElement="input">
            <settings>
                <label translate="true">Tare (kg)</label>
                <notice translate="true">What the packaging itself weighs. Optional; added to what a parcel holds when parcels weigh what's in them. Kept in Magento only.</notice>
                <dataType>text</dataType>
                <dataScope>tare</dataScope>
                <validation><rule name="validate-zero-or-greater" xsi:type="boolean">true</rule></validation>
            </settings>
        </field>
        <field name="cod_amount" formElement="input">
            <settings>
                <label translate="true">Cash on delivery</label>
                <dataType>text</dataType>
                <dataScope>cod_amount</dataScope>
                <validation>
                    <rule name="validate-number" xsi:type="boolean">true</rule>
                    <rule name="validate-zero-or-greater" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="insurance_amount" formElement="input">
            <settings>
                <label translate="true">Insurance</label>
                <dataType>text</dataType>
                <dataScope>insurance_amount</dataScope>
                <validation>
                    <rule name="validate-number" xsi:type="boolean">true</rule>
                    <rule name="validate-zero-or-greater" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="carrier_code" formElement="select">
            <settings>
                <label translate="true">Carrier</label>
                <dataType>text</dataType>
                <dataScope>carrier_code</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Polkurier\Shipping\Model\Config\Source\CarrierName"/>
                        <caption translate="true">Any carrier</caption>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="services" formElement="multiselect">
            <settings>
                <label translate="true">Additional services</label>
                <dataType>text</dataType>
                <dataScope>services</dataScope>
            </settings>
            <formElements>
                <multiselect>
                    <settings>
                        <options class="Polkurier\Shipping\Model\Config\Source\AdditionalService"/>
                    </settings>
                </multiselect>
            </formElements>
        </field>
        <field name="is_default" formElement="checkbox">
            <settings>
                <label translate="true">Default for new shipments</label>
                <dataType>boolean</dataType>
                <dataScope>is_default</dataScope>
                <notice translate="true">Kept in Magento only.</notice>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="string">0</map>
                            <map name="true" xsi:type="string">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
    </fieldset>
</form>
