<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">polkurier_shipment_view.polkurier_shipment_view_data_source</item>
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <namespace>polkurier_shipment_view</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>polkurier_shipment_view.polkurier_shipment_view_data_source</dep>
        </deps>
        <buttons>
            <button name="back" class="Polkurier\Shipping\Ui\Component\Control\ShipmentView\BackButton"/>
            <button name="reconcile" class="Polkurier\Shipping\Ui\Component\Control\ShipmentView\ReconcileButton"/>
            <button name="send_again" class="Polkurier\Shipping\Ui\Component\Control\ShipmentView\SendAgainButton"/>
            <button name="discard" class="Polkurier\Shipping\Ui\Component\Control\ShipmentView\DiscardButton"/>
            <button name="link" class="Polkurier\Shipping\Ui\Component\Control\ShipmentView\LinkButton"/>
            <button name="cancel" class="Polkurier\Shipping\Ui\Component\Control\ShipmentView\CancelButton"/>
            <button name="ship" class="Polkurier\Shipping\Ui\Component\Control\ShipmentView\ShipButton"/>
            <button name="refresh" class="Polkurier\Shipping\Ui\Component\Control\ShipmentView\RefreshButton"/>
            <button name="protocol" class="Polkurier\Shipping\Ui\Component\Control\ShipmentView\ProtocolButton"/>
            <button name="label" class="Polkurier\Shipping\Ui\Component\Control\ShipmentView\LabelButton"/>
        </buttons>
    </settings>
    <dataSource name="polkurier_shipment_view_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <aclResource>Polkurier_Shipping::shipments</aclResource>
        <dataProvider class="Polkurier\Shipping\Ui\Component\Form\ShipmentView\DataProvider" name="polkurier_shipment_view_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <container name="details" component="Polkurier_Shipping/js/shipment/view" sortOrder="10"/>
</form>
