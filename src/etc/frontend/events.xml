<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Multi-address checkout: copy each address's pickup point onto its order -->
    <event name="checkout_type_multishipping_create_orders_single">
        <observer name="polkurier_tag_multishipping_order" instance="Polkurier\Shipping\Observer\TagMultishippingOrder" />
    </event>
    <event name="checkout_submit_all_after">
        <observer name="polkurier_copy_pickup_points" instance="Polkurier\Shipping\Observer\CopyPickupPointsToOrders" />
    </event>
</config>
