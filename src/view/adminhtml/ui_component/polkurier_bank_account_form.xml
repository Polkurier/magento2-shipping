<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">polkurier_bank_account_form.polkurier_bank_account_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Bank account</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <namespace>polkurier_bank_account_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>polkurier_bank_account_form.polkurier_bank_account_form_data_source</dep>
        </deps>
        <buttons>
            <button name="back">
                <url path="*/*/index"/>
                <class>back</class>
                <label translate="true">Back</label>
            </button>
            <button name="delete" class="Polkurier\Shipping\Ui\Component\Control\DeleteBankAccountButton"/>
            <button name="save_and_continue" class="Polkurier\Shipping\Ui\Component\Control\SaveAndContinueBankAccount"/>
            <button name="save" class="Polkurier\Shipping\Ui\Component\Control\SaveButton"/>
        </buttons>
    </settings>
    <dataSource name="polkurier_bank_account_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="*/*/save"/>
        </settings>
        <dataProvider class="Polkurier\Shipping\Ui\Component\Form\BankAccount\DataProvider" name="polkurier_bank_account_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label/>
        </settings>
        <field name="id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>id</dataScope>
            </settings>
        </field>
        <field name="name" formElement="input">
            <settings>
                <label translate="true">Account name</label>
                <dataType>text</dataType>
                <dataScope>name</dataScope>
                <validation><rule name="required-entry" xsi:type="boolean">true</rule></validation>
            </settings>
        </field>
        <field name="number" formElement="input">
            <settings>
                <label translate="true">Account number</label>
                <dataType>text</dataType>
                <dataScope>number</dataScope>
                <validation><rule name="required-entry" xsi:type="boolean">true</rule></validation>
                <notice translate="true">IBAN or Polish account number (26 digits).</notice>
            </settings>
        </field>
        <field name="is_default" formElement="checkbox">
            <settings>
                <label translate="true">Default</label>
                <dataType>boolean</dataType>
                <dataScope>is_default</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="string">0</map>
                            <map name="true" xsi:type="string">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
    </fieldset>
    <fieldset name="confirmation">
        <settings>
            <label translate="true">Confirmation with Polkurier</label>
        </settings>
        <container name="confirmation_note" sortOrder="10">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="component" xsi:type="string">Magento_Ui/js/form/components/html</item>
                    <item name="content" xsi:type="string" translate="true">Polkurier accepts a new or changed bank account only with your confirmation. Without it, the account is saved in Magento and waits for it.</item>
                </item>
            </argument>
        </container>
        <field name="confirmation_pin" formElement="input" sortOrder="20">
            <settings>
                <label translate="true">Security PIN</label>
                <dataType>text</dataType>
                <dataScope>confirmation_pin</dataScope>
                <elementTmpl>Polkurier_Shipping/form/element/password</elementTmpl>
                <notice translate="true">Your account locks bank accounts with a PIN. It is needed to save or delete one.</notice>
                <imports>
                    <link name="visible">${ $.provider }:data.pin_locked</link>
                </imports>
            </settings>
        </field>
        <field name="two_factor_token" formElement="input" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <dataScope>two_factor_token</dataScope>
                <visible>false</visible>
            </settings>
        </field>
        <container name="send_code" component="Polkurier_Shipping/js/moneybox/action" sortOrder="40">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="action" xsi:type="string">send_code</item>
                    <item name="buttonLabel" xsi:type="string" translate="true">Send me the confirmation code</item>
                    <item name="template" xsi:type="string">Polkurier_Shipping/moneybox/action</item>
                    <item name="imports" xsi:type="array">
                        <item name="visible" xsi:type="string">!${ $.provider }:data.pin_locked</item>
                    </item>
                </item>
            </argument>
        </container>
        <field name="two_factor_code" formElement="input" sortOrder="50">
            <settings>
                <label translate="true">Confirmation code</label>
                <dataType>text</dataType>
                <dataScope>two_factor_code</dataScope>
                <imports>
                    <link name="visible">!${ $.provider }:data.pin_locked</link>
                </imports>
            </settings>
        </field>
    </fieldset>
</form>
